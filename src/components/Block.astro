---
import type { Block } from "../lib/types";
import Embed from "./Embed.astro";

type Props = Block;

const { cls = "", n = "", id, h, embed, hEnd, spec, raw = false } = Astro.props;
---

{
  raw ? (
    <section class={`block ${cls}`} id={id}>
      <Fragment set:html={h} />
    </section>
  ) : (
    <section class={`block ${cls}`} id={id}>
      <div class="wrap">
        <div class="blocknum blocklabel" set:html={n} />
        <Fragment set:html={h} />
        {embed && <Embed name={embed.name} caption={embed.caption} />}
        {hEnd && <Fragment set:html={hEnd} />}
        {spec && <div class="spec" set:html={spec} />}
      </div>
    </section>
  )
}
