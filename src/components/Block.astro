---
import type { Block } from "../lib/types";
import Embed from "./Embed.astro";
import { u } from "../lib/base";

type Props = Block;

const { cls = "", n = "", id, h, embed, hEnd, spec, raw = false, bg } = Astro.props;

/* The photograph rides on custom properties rather than a nested <img>: it is
   decoration behind the copy, so it wants no alt text and must not be a
   element the layout has to flow around. */
const bgCls = bg ? `${cls} hasbg`.trim() : cls;
const bgStyle = bg
  ? [
      `--hero-bg:url('${u(bg.src)}')`,
      bg.focus ? `--hero-focus:${bg.focus}` : "",
      bg.scrim ? `--hero-scrim:${bg.scrim}` : "",
    ]
      .filter(Boolean)
      .join(";")
  : undefined;
---

{
  raw ? (
    <section class={`block ${bgCls}`} id={id} style={bgStyle}>
      <Fragment set:html={h} />
    </section>
  ) : (
    <section class={`block ${bgCls}`} id={id} style={bgStyle}>
      <div class="wrap">
        <div class="blocknum blocklabel" set:html={n} />
        <Fragment set:html={h} />
        {embed && <Embed name={embed.name} caption={embed.caption} />}
        {hEnd && <Fragment set:html={hEnd} />}
        {spec && <div class="spec" set:html={spec} />}
      </div>
    </section>
  )
}
