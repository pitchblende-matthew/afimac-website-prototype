---
/**
 * Option H's mega menu as a page header, rather than as a mock on the options
 * page.
 *
 * Same markup from src/lib/mega-nav.ts that /nav-options renders, not a copy.
 * This component adds the framing a header needs: a band to sit in, a line
 * saying what it is, and the cascade behaviour.
 *
 * The prototype's own SubNav still runs underneath, so a reviewer can get back
 * out of the page.
 */
import { megaNavDown } from "../lib/mega-nav";

interface Props {
  /** The line above the bar saying what a reviewer is looking at. */
  note?: string;
  /**
   * Render nothing but the cascade script. Used when the menu is already in
   * the page — in the site header, via the layout's `megaNav` prop — and all
   * that is wanted is the behaviour.
   */
  scriptOnly?: boolean;
}
const { note, scriptOnly } = Astro.props;
---

{
  !scriptOnly && (
    <div class="megah">
      {note && <p class="megah-note" set:html={note} />}
      <div class="megah-bar" set:html={megaNavDown()} />
    </div>
  )
}

<script is:inline>
  /* Hover, click and keyboard focus — the same three events the options page
     binds. A hover-only cascade has no touch equivalent. */
  (() => {
    const bind = (tier) => {
      if (tier.dataset.cascade) return;
      tier.dataset.cascade = "1";
      const pick = (sol, sec) => {
        tier.querySelectorAll("[data-sol]").forEach((e) => e.classList.toggle("on", e.dataset.sol === sol));
        tier.querySelectorAll("[data-sec]").forEach((e) => e.classList.toggle("on", e.dataset.sec === sec));
        tier.querySelectorAll("[data-pane]").forEach((e) => e.classList.toggle("on", e.dataset.pane === sec));
      };
      const on = (el, fn) => ["mouseenter", "focus", "click"].forEach((ev) => el.addEventListener(ev, fn));
      tier.querySelectorAll("[data-first]").forEach((b) => on(b, () => pick(b.dataset.sol, b.dataset.first)));
      tier.querySelectorAll("[data-sec]").forEach((b) => on(b, () => pick(b.dataset.sec.split("-")[0], b.dataset.sec)));
    };
    document.querySelectorAll(".megah .no-tier, .site-header .no-tier").forEach(bind);
  })();
</script>
