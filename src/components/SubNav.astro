---
import { NAV, statusCaption, kidPhase } from "../data/nav";
import { u } from "../lib/base";
import type { NavItem } from "../data/nav";

interface Props {
  /** Route of the current page, e.g. "/how-it-works". */
  active?: string;
}

const { active = "" } = Astro.props;

const isActive = (item: NavItem) =>
  active === item.route || (item.kids ?? []).some((kid) => kid.route === active);

/** Status dot: fill shows the work state, a green ring means the page is
    already live. Prototype chrome — see the legend in the WIP bar. */
const dot = (n: { work: string; live?: boolean }) =>
  `<span class="sdot s-${n.work}${n.live ? " is-live" : ""}"></span>`;
---

<nav class="subnav" id="subnav">
  <div class="wrap">
    <span class="mark">Travel Labor</span>
    <button class="mobtoggle" id="mobtoggle">Travel Labor menu &#9662;</button>
    <div id="subnavItems" style="display:contents">
      {
        NAV.map((item) => (
          <div class={`snitem${isActive(item) ? " active" : ""}`} data-min={item.phase}>
            {/* Label, dot and caret are set as one HTML string: separate children
                would have JSX whitespace between them, which shows as a gap. */}
            <a
              class="snlink"
              href={u(item.route)}
              set:html={
                dot(item) + item.label + (item.kids ? '<span class="caret">▼</span>' : "")
              }
            />
            {item.kids && (
              <div class="dd">
                <div class="ddhead" set:html={statusCaption(item.kids)} />
                {item.kids.map((kid) => (
                  <a
                    href={u(kid.route)}
                    data-min={kidPhase(item, kid)}
                    set:html={dot(kid) + kid.label}
                  />
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
    {/* Phase 0 is today: these pages are live but nothing links them. */}
    <span class="phase0note">No CSTL sub-nav exists today — the live pages are not linked as a section.</span>
    <a class="snCta" href={u("/get-in-touch")} data-min="1">Get in Touch</a>
  </div>
</nav>
