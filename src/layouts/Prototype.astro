---
import "../styles/prototype.css";
import SubNav from "../components/SubNav.astro";
import PageMeta from "../components/PageMeta.astro";
import AssetBand from "../components/AssetBand.astro";
import Logo from "../components/Logo.astro";
import { u } from "../lib/base";
import { WORK_LABEL, sectionTotals, type Work } from "../data/nav";
import type { PageProps } from "../lib/types";

type Props = PageProps;

const { title, crumb, url, status, meta, active } = Astro.props;

const plainTitle = title.replace(/&amp;/g, "&");

const KEYS: Work[] = ["settled", "ready", "partial", "todo"];
const totals = sectionTotals();

/**
 * Prototype chrome the reviewer can switch off. `cls` is added to <body> when
 * the box is UNchecked, so the default (all on) needs no class at all.
 */
const TOGGLES = [
  { cls: "nospec", label: "Build notes", hint: "Elementor mapping under each block" },
  { cls: "nonotes", label: "Notes &amp; conflicts", hint: "Observations and open items" },
  { cls: "nometa", label: "SEO &amp; page meta", hint: "Title, description and slug table" },
  { cls: "nolabels", label: "Block labels", hint: "BLOCK 01 · HERO captions" },
  { cls: "noassets", label: "Content assets", hint: "Approved monday.com assets and where they belong" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>AFIMAC CSTL prototype · {plainTitle}</title>
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mulish:wght@300;400;600;700;800&family=Zilla+Slab:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <script is:inline>
      /* Applied before first paint so a saved "clean view" doesn't flash the
         chrome on every navigation. The module script below syncs the boxes. */
      try {
        var saved = JSON.parse(localStorage.getItem("afimac-cstl:chrome") || "{}");
        for (var cls in saved) if (!saved[cls]) document.body.classList.add(cls);
      } catch (e) {}
    </script>

    <div class="protobar">
      <div class="wrap">
        <div class="row">
          <span class="lbl">Prototype · work in progress</span>
          <span>
            Colours sampled from the live page. Type falls back to Zilla Slab / Mulish
            without Museo installed. Grey bars = copy not written · dashed panels =
            photography to source.
          </span>
        </div>

        <div class="row">
          <span class="lbl">Show</span>
          {
            TOGGLES.map((t) => (
              <label title={t.hint}>
                <input type="checkbox" data-toggle={t.cls} checked />
                <Fragment set:html={t.label} />
              </label>
            ))
          }
          <span class="acts">
            <button type="button" id="chromeOff">Clean view</button>
            <button type="button" id="chromeOn">Show everything</button>
          </span>
        </div>

        <div class="row statuskey">
          <span class="lbl">Build status</span>
          {
            KEYS.map((w) => (
              <span class="k">
                <span class={`sdot s-${w}`} />
                <Fragment set:html={WORK_LABEL[w]} />
                <span class="n">{totals.work[w]}</span>
              </span>
            ))
          }
          <span class="k">
            <span class="sdot s-todo is-live" />
            Green ring = already live, so the work is an update
            <span class="n">{totals.live}</span>
          </span>
        </div>
      </div>
    </div>

    <div class="crisisbar">
      <div class="wrap">
        <a href={u("/get-in-touch")}>&#9889; I have a critical labor situation</a>
      </div>
    </div>

    <header class="site-header">
      <div class="wrap">
        <a href={u("/overview")} aria-label="AFIMAC home"><Logo width={150} /></a>
        <ul>
          <li><a href={u("/overview")}>Home</a></li>
          <li><a href={u("/overview")}>Solutions &#9662;</a></li>
          <li><a href={u("/overview")}>Insights</a></li>
          <li><a href={u("/overview")}>About &#9662;</a></li>
          <li><a href={u("/get-in-touch")}>Contact</a></li>
        </ul>
        <span class="hicons">&#9906; &nbsp; in &nbsp; f</span>
      </div>
    </header>

    <SubNav active={active} />

    <div class="crumb">
      <div class="wrap" id="crumb">
        <a href={u("/overview")}>Home</a> › <Fragment set:html={crumb} />
        <span style="float:right">
          {
            status === "live" ? (
              <span class="tag live">LIVE</span>
            ) : (
              <span class="tag build">BUILD</span>
            )
          }
          <span style="color:#b3bcc7">{url}</span>
        </span>
      </div>
    </div>

    <main id="app">
      {meta && <PageMeta meta={meta} url={url} />}
      <AssetBand route={active} />
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div><Logo variant="rev" width={160} /></div>
        <div>
          <h5>Quick Links</h5>
          <ul>
            <li><a href={u("/overview")}>Home</a></li>
            <li><a href={u("/overview")}>Solutions</a></li>
            <li><a href={u("/overview")}>Insights</a></li>
            <li><a href={u("/get-in-touch")}>Contact</a></li>
          </ul>
        </div>
        <div>
          <h5>Legal</h5>
          <ul>
            <li><a href={u("/overview")}>Privacy Policy</a></li>
            <li><a href={u("/overview")}>Terms Of Use</a></li>
          </ul>
        </div>
        <div class="hicons" style="color:#fff">in &nbsp; f</div>
        <div class="fine">
          AFIMAC Global — CSTL section prototype · pitchblende · v0.3 · not for publication
        </div>
      </div>
    </footer>

    <script>
      /* ---- prototype chrome toggles -------------------------------------
         Persisted, because the prototype navigates between real pages rather
         than hash routes — without this every toggle would reset on each
         click. The inline script at the top of <body> applies the saved state
         before paint; this syncs the checkboxes and handles changes. */
      const CHROME_KEY = "afimac-cstl:chrome";
      const boxes = Array.from(
        document.querySelectorAll<HTMLInputElement>(".protobar input[data-toggle]"),
      );

      const save = () =>
        localStorage.setItem(
          CHROME_KEY,
          JSON.stringify(Object.fromEntries(boxes.map((b) => [b.dataset.toggle!, b.checked]))),
        );

      const apply = () => {
        boxes.forEach((b) => document.body.classList.toggle(b.dataset.toggle!, !b.checked));
        save();
      };

      let saved: Record<string, boolean> = {};
      try {
        saved = JSON.parse(localStorage.getItem(CHROME_KEY) || "{}");
      } catch {}

      boxes.forEach((b) => {
        const cls = b.dataset.toggle!;
        if (cls in saved) b.checked = saved[cls];
        b.addEventListener("change", apply);
      });
      apply();

      const setAll = (on: boolean) => {
        boxes.forEach((b) => (b.checked = on));
        apply();
      };
      document.getElementById("chromeOff")?.addEventListener("click", () => setAll(false));
      document.getElementById("chromeOn")?.addEventListener("click", () => setAll(true));

      /* ---- mobile sub-nav ---- */
      document.getElementById("mobtoggle")?.addEventListener("click", () => {
        document.body.classList.toggle("menuopen");
      });

      /* ---- count-up on the stat blocks, as the live page does ---- */
      document.querySelectorAll<HTMLElement>(".stat[data-count]").forEach((el) => {
        const target = parseInt(el.dataset.count!, 10);
        const suffix = el.dataset.suffix || "";
        const fmt = (n: number) => n.toLocaleString("en-US") + suffix;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          el.textContent = fmt(target);
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              io.disconnect();
              const dur = 1200;
              const t0 = performance.now();
              const tick = (now: number) => {
                const p = Math.min((now - t0) / dur, 1);
                el.textContent = fmt(Math.round(target * (1 - Math.pow(1 - p, 3))));
                if (p < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            });
          },
          { threshold: 0.4 },
        );
        io.observe(el);
      });
    </script>
  </body>
</html>
