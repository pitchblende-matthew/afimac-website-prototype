/**
 * DAY 1 READY — package anchor page.
 *
 * Full approved copy, v1. The printable checklist download (block 04) is still
 * held; block 07 now carries the What is Day 1 Ready one-pager as a direct
 * download. The held block waits on
 * assets still in production, and the deck says to hide them until those ship.
 * They are built here and marked, rather than omitted, so the page can be
 * turned on in one edit rather than rebuilt.
 */
import Prototype from "../layouts/Prototype.astro";
import Block from "../components/Block.astro";
import { u } from "../lib/base";
import { B } from "../data/nav";
import { photo, figure, artPair, downloadCard } from "../lib/wireframe";
import { D1R_SEAL, D1R_SEAL_STANDALONE, D1R_TIMELINE, D1R_FORM_ILLUSTRATION } from "../data/graphics";
import { CLIENT_CHECKLIST, READY_CHECKS, DAY1_FORM_BULLETS } from "../data/day1";
import type { Block as BlockType } from "../lib/types";

const PACKAGE_BLOGS = [
  "Pre-Deployment Process Deep-Dive",
  "How We Manage AFIMAC Talent",
  "How We Measure a Successful Deployment",
];

const blocks: BlockType[] = [
  {
    cls: "dark",
    n: "BLOCK 01 · HERO",
    h: `
  <p class="eyebrow">Critical Situation Travel Labor · Day 1 Ready</p>
  <h1>Day 1 Ready</h1>
  <p class="sub"><b>Not Just On Site Fast. Productive From the First Shift.</b></p>
  <p class="lead">Anyone can promise a fast crew. Day 1 Ready is AFIMAC’s standard for what that crew looks like when it walks in: screened, credentialed, housed, safety-onboarded, and supervised, so the first shift produces instead of orienting.</p>
  <div class="btns"><a class="btn" href="${u("/get-in-touch")}">Let’s talk</a><a class="btn ghost" href="#ready">See what ready means</a></div>
  <div style="margin-top:34px">${photo("Full-bleed hero · 2560×1440 JPG (min 2000px wide) · a crew walking onto a floor at shift start, badged and in PPE, supervisor at the front, first light through the bay doors · muted industrial tone under the navy scrim · focal area centre · mobile crop 1080×1350")}</div>`,
    spec: `<b>Elementor:</b> Container (bg image + navy overlay) · Breadcrumbs · Heading ×3 · Text Editor · Button ×2.`,
  },

  {
    id: "ready",
    n: "BLOCK 02 · WHAT DAY 1 READY MEANS",
    h: `
  <h2>Ready is a checklist, not a feeling</h2>
  <div class="g2 g2-stats" style="margin-top:24px">
   <div>
    <p>Before any AFIMAC crew reaches your floor, five things are already done. Every worker has cleared background, credential, and role checks. Travel is booked and housing is set. Site-specific safety and role onboarding is complete. And an on-site AFIMAC supervisor arrives with them, so there’s a single point of contact from the first hour.</p>
    <ul class="tick" style="margin-top:20px">${READY_CHECKS.map((c) => `<li>${c}</li>`).join("")}</ul>
   </div>
   <div class="figcenter" style="--figw:420px">${figure({ ...D1R_SEAL, maxWidth: 420 })}</div>
  </div>
  <div class="note"><b>Built once, cropped from the same art.</b> The standalone crop the deck wants for LinkedIn and the package pieces shipped with it: same geometry, spokes and outer labels removed, so the two cannot drift apart. <a href="${u(D1R_SEAL_STANDALONE.src)}" target="_blank" rel="noopener">Open the standalone crop →</a> <b>The strip form</b> the <a href="${u("/pre-deployment")}">Pre-Deployment Checklist</a> reuses was not part of this delivery.</div>`,
    spec: `<b>Elementor:</b> Container (2-col) · Heading · Text Editor · EK Icon List · Image (SVG) — <code>/graphics/afimac-d1r-seal.svg</code>.`,
  },

  {
    cls: "wash",
    n: "BLOCK 03 · INSIDE PRE-DEPLOYMENT",
    h: `
  <h2><a href="${u("/how-it-works")}">The work that happens before we arrive</a></h2>
  <p class="lead">Day 1 Ready is earned in the days before day one. Assessment maps your roles, shift coverage, and site requirements — timing varies by engagement. Mobilization can begin rapidly once approved: sourcing and screening from a 20,000+ talent network, credential and role checks, travel and housing, and site-specific safety onboarding. By the time the crew travels, the only thing left to do is the work.</p>
  <div style="margin:24px 0">${artPair(D1R_TIMELINE)}</div>
  <div class="note"><b>A second timeline, but it answers a different question.</b> The <a href="${u("/how-it-works")}">four-phase timeline</a> asks when the crew arrives; this one asks what is already done by the time it does, so each phase carries its steps and the band ends at <b>first shift</b> rather than running on through Deployment and Demobilization. Neither carries a day scale any more, and the wording under each phase matches the paragraph above word for word.</div>
  <div class="note"><b>Says Assessment, like every graphic in the 5 Oct delivery — the duration half is closed.</b> This page used to say <b>Assessment · 1 to 2 days</b> against the live overview’s <b>Consultation · 2 to 3 days</b>. Under the directional timing adopted 25 Sep 2026 neither figure is stated here any more. The name is still unsettled. <a href="${u("/brand-check")}">Still open →</a></div>`,
    spec: `<b>Elementor:</b> Heading (linked to the hub) · Text Editor · Image (SVG) — <code>/graphics/afimac-d1r-pre-deployment-timeline.svg</code>, with the stacked cut swapped in under 768px via responsive visibility.`,
  },

  {
    n: "BLOCK 04 · WHAT YOU DO BEFORE WE ARRIVE",
    h: `
  <h2>Your side of day one fits on one page</h2>
  <p class="lead">Most of the readiness work is ours. Yours is short, and it’s the same five items on every engagement:</p>
  <ul class="check" style="margin-top:20px">${CLIENT_CHECKLIST.map((c) => `<li>${c}</li>`).join("")}</ul>
  <div class="note stop" style="margin-top:24px"><b>Held: the download line is hidden until the printable ships.</b> The deck specifies “Get the printable version: What to Do Before We Arrive” here, pointing at the package’s checklist deliverable, which is still in production. The line is built but suppressed — turn it on when the PDF lands.</div>
  <div class="note"><b>These five items are shared with the <a href="${u("/pre-deployment")}">Pre-Deployment Checklist</a>, and the deck says so explicitly.</b> The prototype renders both from one list in <code>src/data/day1.ts</code>, so they cannot drift. Keep that arrangement in the build — a global block or a reusable Elementor container, not two copies.</div>
  <div class="note"><b>The list itself is placeholder structure.</b> The deck drafted it from the approved Assessment and onboarding copy; the checklist deliverable finalizes it. Expect these five to change once.</div>`,
    spec: `<b>Elementor:</b> Heading · Text Editor · EK Icon List (check icons). Build as a global block so this page and the checklist page share one source.`,
  },

  {
    cls: "wash",
    n: "BLOCK 05 · DAY ONE ITSELF",
    h: `
  <h2>What the first shift looks like</h2>
  <p class="lead">The crew arrives badged and briefed, and starts work. An on-site AFIMAC supervisor runs the day and stays your single point of contact. A daily feedback loop starts immediately, tracking output from the first shift, and the crew scales up or down from there as the situation changes.</p>
  <div style="margin:24px 0">${photo("1600×1000 JPG (8:5) · a supervisor walking the line with a clipboard beside a working crew, first-shift energy · a working shot with nothing posed")}</div>
  <div class="note"><b>Video slot, held.</b> The package’s “AFIMAC Keeps Production Moving” video belongs here — 1920×1080 MP4, poster frame, play control, no autoplay, captions on, lazy-loaded. Until it ships the section runs with the image above, which is what is shown.</div>`,
    spec: `<b>Elementor:</b> Heading · Text Editor · Video widget (or Image until the video ships). <b>Do not autoplay</b> — captions on by default.`,
  },

  {
    n: "BLOCK 06 · HOW SUCCESS IS MEASURED",
    h: `
  <h2>Tracked daily, reviewed at the end</h2>
  <p class="lead">Success measures are scoped during Assessment, before anyone travels. Daily output tracking keeps you in the loop through the engagement, and a final performance review closes it out. The published record is the standard we hold ourselves to: a 73.4% cut in past-due sales at one Fortune 500 manufacturer, and a two-year engagement that returned another to on-time order fulfillment.</p>
  <div class="note"><b>Both proof points are published on the live pillar</b> — link each to it. The package’s “How We Measure a Successful Deployment” blog expands this section and links back here when it publishes.</div>`,
    spec: `<b>Elementor:</b> Heading · Text Editor. Same two proof points as <a href="${u("/vs-traditional")}">Travel vs. Traditional</a> — keep the wording aligned across both.`,
  },

  {
    cls: "sky",
    id: "one-pager",
    n: "BLOCK 07 · THE ONE-PAGER",
    h: `
  ${downloadCard({
    file: "/downloads/afimac-what-is-day-1-ready.pdf",
    saveAs: "AFIMAC - What is Day 1 Ready.pdf",
    cover: "/graphics/afimac-what-is-day-1-ready-cover.jpg",
    coverAlt: "Cover of the What is Day 1 Ready one-pager",
    heading: "Want to learn more? Download the one-pager",
    body: "What Day 1 Ready means and what it takes to get there, on a single page you can print or pass along to your operations team.",
    button: "Download the one-pager",
    meta: "PDF · 1 page · 118 KB",
  })}
  <div class="note"><b>Why here.</b> The script reserves this slot for the standard on one page, after the reader has been through the definition, the pre-deployment work, day one and how success is measured, and just before the related reading. By this point the reader is deciding whether to take it to their team, which is what the one-pager is for. Placing it higher, beside the definition in block 02, would offer a summary of a page the reader has not read yet.</div>
  <div class="note"><b>Ungated, as asked.</b> This slot was specced as a gated one-sheet behind a four-field Metform. It now downloads directly, which also settles the earlier worry about two forms on adjacent pages. If the team wants the lead capture back, the same card works with the button pointing at a Metform popup instead of the file.</div>
  <div class="note stop"><b>The one-pager’s speed line does not follow the approved wording.</b> Its footer reads <b>“Your team can typically deploy in 72 hours or less.”</b> “Or less” makes 72 hours a ceiling, which is the hard promise the Soft/Directional card was chosen to avoid; the approved line is <b>“Teams can mobilize in as little as 72 hours.”</b> Worth correcting in the design file before this goes live, since everything else on the page says “as little as”.</div>
  <div class="note"><b>Its four pillars are not the seal’s five checks.</b> The one-pager defines Day 1 Ready as <b>Skilled · Vetted · Matched · Ready</b>; block 02 and the seal say <b>Screened · Credentialed · Housed · Safety-onboarded · Supervised</b>. They are compatible rather than contradictory, but a reader who downloads it after reading the page will see two different lists for the same standard.</div>`,
    spec: `<b>Elementor:</b> Container (2-col, white background, 14px radius, 1px #CFDBE2 border) · Image (cover JPG, linked to the PDF) · Heading (eyebrow, “Free one-pager · PDF”) · Heading (H3) · Text Editor · Button. <b>Upload the PDF to the Media Library and paste its URL into the Button link and the Image link.</b> To make it download rather than open, in the link options (cog icon) add the custom attribute <code>download|AFIMAC - What is Day 1 Ready.pdf</code>; without it the PDF opens in a new tab, which is an acceptable fallback, so also tick “Open in new window”. Stack the columns under 640px.`,
  },

  {
    n: "BLOCK 08 · RELATED INSIGHTS",
    h: `
  <h2>Related insights</h2>
  <div class="g3" style="margin-top:22px">
   ${PACKAGE_BLOGS.map((t) => `<div class="card">${photo("1280×720 (16:9) · pulled from the post’s featured image")}<h3 style="margin-top:16px">${t}</h3><a class="readmore" href="${u("/overview")}">Read More »</a></div>`).join("")}
  </div>
  <div class="note stop"><b>None of these three exist yet.</b> All are Day 1 Ready package blogs scheduled through the board. Slot each in as it publishes and run the rail with live skilled-labor posts in the meantime — this rail is empty on launch day otherwise.</div>`,
    spec: `<b>Elementor:</b> EK Post Grid (3-up) once the posts exist; manual Icon Boxes before then.`,
  },

  {
    cls: "sky",
    n: "BLOCK 09 · TALK TO AFIMAC (LEAD FORM)",
    h: `
  <div class="g2">
   <div>
    <h2>Want a crew that’s ready on day one?</h2>
    <p>Tell us what you’re facing and we’ll come back with:</p>
    <ul class="tick">${DAY1_FORM_BULLETS.map((b) => `<li>${b}</li>`).join("")}</ul>
    <p style="margin-top:22px"><b style="color:#fff">Urgent line</b> · 1.800.554.4622</p>
    <div style="margin-top:22px">${figure(D1R_FORM_ILLUSTRATION)}</div>
   </div>
   <div>
    <div class="form">
     <input placeholder="First name"><input placeholder="Last name">
     <input class="full" placeholder="Company">
     <input placeholder="Work email"><input placeholder="Phone">
     <input class="full" placeholder="Site location (City, State/Province)">
     <textarea class="full" rows="4" placeholder="Tell us about your situation"></textarea>
     <div class="full"><a class="btn" href="${u("/get-in-touch")}">Talk to a specialist</a></div>
     <p class="full" style="font-size:12.5px">By submitting, you agree to AFIMAC’s Privacy Policy. We respond within one business day.</p>
    </div>
   </div>
  </div>`,
    spec: `<b>Elementor:</b> Metform · EK Icon List · Button. Global block.`,
  },

  {
    cls: "wash",
    n: "OPEN ITEM · THE SPEED CLAIM, SETTLED IN FORM BUT NOT IN SOURCE",
    h: `<div class="note"><b>This was the section’s most-repeated conflict, and the directional timing ends most of it.</b> Five wordings of one promise were in circulation: <b>24 to 72 hours</b> on the live pillar meta, <b>on-site in 2 to 7 days</b> in the Maria-reviewed ad tracker, <b>within days</b> from the approved process doc’s phase math, and <b>6–7</b> and <b>5–7 days</b> from the industry decks. Every page in the build now says the same thing, and states one figure: <b>as little as 72 hours</b>.</div>
  <div class="note stop"><b>Which puts the whole weight of the claim on a figure editorial rejected a month earlier.</b> On <b>21 Aug 2026</b> the ruling was that <b>6–7 days</b> is the defendable number and that “as fast as 72 hours” should come out of the graphics — and it did. The directional option names <b>72 hours</b> as its anchor, and its own stated risk is that “as little as” language <b>needs at least one verified anchor point or it reads as unsubstantiated</b>. <b>So 72 hours has to be re-verified, or the anchor has to change.</b> Nothing else in the section carries a number any more. <a href="${u("/brand-check")}">The full record →</a></div>`,
    spec: `The form of the claim is settled. The source of the 72-hour figure is not, and it is now load-bearing in a way it was not when several figures shared the weight.`,
  },
];
