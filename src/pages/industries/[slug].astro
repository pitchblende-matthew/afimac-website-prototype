---
import Prototype from "../../layouts/Prototype.astro";
import Block from "../../components/Block.astro";
import { u } from "../../lib/base";
import { INDUSTRIES, EXISTING } from "../../data/industries";
import {
  LIVE_INDUSTRIES,
  LIVE_SITUATIONS,
  LIVE_ROLE_GROUPS,
  LIVE_CREDIBILITY_BODY,
  LIVE_COUNTERS,
  GENERIC_POSTS,
} from "../../data/live-industries";
import { industryPage } from "../../lib/industry-page";
import type { Block as BlockType } from "../../lib/types";

// Rendered on demand — `output: "server"` is the Webflow Cloud contract, so
// there is no getStaticPaths here; unknown slugs 404 below.
const { slug } = Astro.params;
const built = slug ? INDUSTRIES[slug] : undefined;
const existing = slug && !built ? EXISTING[slug] : undefined;

if (!built && !existing) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

/**
 * The live industry page, as published.
 *
 * Read off afimacglobal.com on 9 Sep 2026 rather than approximated — Phase 0 of
 * the rollout is "current state", so this needs to be what is actually there.
 * The shared blocks are shared on the live site too, identical word for word on
 * all seven, which is the finding this page exists to make visible.
 */
const liveTemplate = (slug: string): BlockType[] => {
  const p = LIVE_INDUSTRIES[slug];
  if (!p) return [];
  const shared = () =>
    `<b>Identical on all seven live pages.</b> Nothing in this block is about ${p.gapsH2.replace(/ Workforce Gaps We Fill$/, "")}.`;
  const isGeneric = p.risks[0] === "Operational inefficiency";

  return [
    {
      n: "PHASE 0 · THIS IS THE LIVE PAGE",
      h: `<div class="note" style="margin-top:0"><b>This is the page as published today</b>, read off afimacglobal.com on 9 Sep 2026 — not a sketch of it. It is what a visitor sees at <a href="${u(`/industries/${slug}`)}">this URL</a> right now, and what <a href="${u("/launch-phases")}">launch phase 0</a> means for this industry. Updated copy arrives in phase 2.</div>`,
      spec: `Live SEO title: <code>${p.seoTitle}</code>`,
    },
    {
      cls: "dark",
      n: "BLOCK 01 · HERO — AS LIVE",
      h: `
  <h1>${p.h1}</h1>
  <p class="sub"><b>${p.tagline}</b></p>
  <p class="lead">${p.intro}</p>
  <div class="btns"><a class="btn" href="${u("/get-in-touch")}">Talk to AFIMAC</a></div>${
    slug === "oil-energy"
      ? `\n  <div class="note stop"><b>The live H1 reads “Oil &amp; <i>energy</i> Travel Labor”</b> — lower-case <i>energy</i>, shown here exactly as published. The SEO title capitalises it correctly, so the two disagree. A one-word fix on a live page.</div>`
      : ""
  }`,
      spec: `<b>Elementor:</b> Container · Heading ×2 · Text Editor · Button. The tagline is the only line in this hero that is genuinely industry-specific.`,
    },
    {
      n: "BLOCK 02 · THE INDUSTRY’S WORKFORCE CHALLENGE — AS LIVE",
      h: `
  <h2>${p.headwindsH2}</h2>
  <p class="lead">${p.headwindsBody}</p>
  <p style="font-size:13px;color:var(--spec)">*Source: ${p.source}.</p>
  <div class="note"><b>This is the block that is really about the industry</b>, and the only one carrying a cited third-party figure. Each of the seven cites a different analyst. <b>Keep the citation live through any update</b> — it is what separates these pages from the generic ones.</div>`,
      spec: `<b>Elementor:</b> Heading · Text Editor. The block a CSTL update would most likely rewrite.`,
    },
    {
      cls: "wash",
      n: "BLOCK 03 · CRITICAL SITUATIONS WE ADDRESS — AS LIVE",
      h: `
  <p class="lead">${p.situationsIntro}</p>
  <div class="g2" style="margin-top:26px">
   <div class="duo"><div class="duohead">Critical Situations We Handle:</div>
    <div class="duobody"><ul class="check">${LIVE_SITUATIONS.map((x) => `<li>${x}</li>`).join("")}</ul></div></div>
   <div class="duo risk"><div class="duohead">Risks We Help You Mitigate:</div>
    <div class="duobody"><ul class="warn">${p.risks.map((x) => `<li>${x}</li>`).join("")}</ul></div></div>
  </div>
  <div class="note">${shared()} The left card is the same five items on all seven pages and on the Overview.</div>
  ${
    isGeneric
      ? `<div class="note stop"><b>And the right card is generic too, on this page.</b> Five of the seven — Chemicals &amp; Plastics, Consumer Goods, Food &amp; Beverage, Industrial Equipment and Oil &amp; Energy — carry the identical risk list shown here. Only <a href="${u("/industries/aerospace-aviation-defense")}">Aerospace</a> and <a href="${u("/industries/automotive")}">Automotive</a> have risks written for them. <b>So on five of seven pages, the entire block is boilerplate.</b></div>`
      : `<div class="note"><b>The right card is genuinely industry-specific here</b> — one of only two pages where it is. The other five share a generic list.</div>`
  }`,
      spec: `<b>Elementor:</b> Container (2-col) · Heading ×2 · EK Icon List ×2. Shared saved section with the Overview.`,
    },
    {
      n: "BLOCK 04 · WORKFORCE GAPS WE FILL — AS LIVE",
      h: `
  <h2>${p.gapsH2}</h2>
  <div class="g3" style="margin-top:26px">
   ${LIVE_ROLE_GROUPS.map(([g, roles], i) => `<div><div class="catbar ${["mfg", "whs", "log"][i]}">${g}</div><ul class="check">${roles.map((r) => `<li>${r}</li>`).join("")}</ul></div>`).join("")}
  </div>
  <div class="note stop"><b>The heading names the industry and the fifteen roles underneath do not.</b> ${shared()} These are the same fifteen roles, in the same three groups, in the same order, on every one of the seven pages. <b>It is the clearest single argument for the CSTL update</b>, and the reason the role work matters.</div>`,
      spec: `<b>Elementor:</b> Container (3-col) · Heading ×3 · EK Icon List ×3. One shared saved section reused seven times.`,
    },
    {
      cls: "center",
      n: "BLOCK 05 · AFIMAC CREDIBILITY — AS LIVE",
      h: `
  <h2>AFIMAC Credibility</h2>
  <p class="lead">${p.credibilityLead}</p>
  <p>${LIVE_CREDIBILITY_BODY}</p>
  <div class="g4" style="margin-top:30px">
   ${LIVE_COUNTERS.map((c) => `<div><div class="stat" style="color:var(--ph)">—</div><p>${c}</p></div>`).join("")}
  </div>
  <div class="note stop"><b>A fifth set of credibility figures.</b> These four counters — ${LIVE_COUNTERS.join(" · ")} — are not the four in the approved June-05 package, not the three on the automotive stat band, and not the three the Logistics deck specifies. <b>The figures themselves cannot be read off the page</b>: they animate up from zero, so the published values are only in the Elementor settings. <a href="${u("/brand-check")}">All conflicts →</a></div>
  <div class="note">Only the first line is industry-specific. The paragraph under it is identical on all seven pages and on the hub.</div>`,
      spec: `<b>Elementor:</b> Heading ×2 · Text Editor · EK Funfact / Counter ×4. Counters animate on scroll.`,
    },
    {
      cls: "wash",
      n: "BLOCK 06 · RELATED NEWS + INSIGHT — AS LIVE",
      h: `
  <h2>Related News + Insight</h2>
  <div class="g3" style="margin-top:22px">
   ${[p.ownPost, ...GENERIC_POSTS].map((t, i) => `<div class="card"><h4>${t}</h4><p style="font-size:12.5px;color:var(--spec)">${i ? "Shared with all seven pages" : "This page’s own post"}</p><a class="readmore" href="${u("/overview")}">Read More »</a></div>`).join("")}
  </div>
  <div class="note"><b>One of the three is about this industry; the other two are the same on every page.</b> The rail is hand-picked rather than filtered, which is why it never refreshes.</div>`,
      spec: `<b>Elementor:</b> EK Post Grid (3-up, manual selection).`,
    },
    {
      cls: "sky",
      n: "BLOCK 07 · LEAD FORM — AS LIVE",
      h: `
  <h2>${p.formHeading}</h2>
  <p>Let’s talk today and we’ll provide solutions matched to your needs:</p>
  <ul class="check" style="display:inline-block;text-align:left"><li>Available labor resources</li><li>Rapid deployment timing</li><li>Ballpark costs</li><li>Estimated ROI impact</li></ul>
  ${
    p.formHeading === "Get the Numbers"
      ? `<div class="note stop"><b>This page’s form is headed “Get the Numbers”; five of the seven say “Talk to AFIMAC.”</b> Only this page and <a href="${u(`/industries/${slug === "consumer-goods" ? "food-beverage" : "consumer-goods"}`)}">the other one</a> differ. Same form, same four bullets, two different headings — and the two variants split conversions in reporting.</div>`
      : `<div class="note">Headed “Talk to AFIMAC.”, as five of the seven are. <a href="${u("/industries/consumer-goods")}">Consumer Goods</a> and <a href="${u("/industries/food-beverage")}">Food &amp; Beverage</a> say “Get the Numbers” instead.</div>`
  }`,
      spec: `<b>Elementor:</b> Metform · EK Icon List. Global block — note the heading is not global.`,
    },
  ];
};

const page = built ? industryPage(built) : null;
const blocks: BlockType[] = built
  ? page!.blocks
  : [
      {
        n: "STATUS · LIVE, NO CSTL UPDATE WRITTEN",
        h: `
  <h2>${existing!.label}</h2>
  <p class="lead">This page is live on afimacglobal.com and carries the copy below today. <b>No CSTL update has been written for it</b> — it is one of five in that position. The page’s single H1 is the live page’s own, in the hero block below.</p>
  <div class="tscroll"><table class="cmp" style="max-width:900px"><tbody>
   <tr><th>Live URL</th><td>${existing!.url}</td></tr>
   <tr><th>SEO title today</th><td>${existing!.seoTitle} <span style="color:var(--spec)">(${existing!.seoTitle.replace(/&amp;/g, "&").length} chars · target 50–60)</span></td></tr>
   <tr><th>Meta description today</th><td>${existing!.seoDesc} <span style="color:var(--spec)">(${existing!.seoDesc.length} chars · target 145–160)</span></td></tr>
  </tbody></table></div>
  ${existing!.note ? `<div class="note">${existing!.note}</div>` : ""}
  <div class="btns"><a class="btn ghost" href="${u("/industries/automotive")}">See what an update looks like →</a></div>`,
        spec: `Wireframed below is the live page as it stands, so the scope of an update is visible. <b>Nothing here is new copy.</b>`,
      },
      ...liveTemplate(existing!.slug),
    ];
---

{
  built ? (
    <Prototype {...page!}>
      {blocks.map((b) => <Block {...b} />)}
    </Prototype>
  ) : (
    <Prototype
      title={existing!.label}
      crumb={`Solutions › CSTL › Industries › ${existing!.label}`}
      url={existing!.url}
      status="live"
      active={`/industries/${existing!.slug}`}
      meta={{
        t: existing!.seoTitle,
        d: existing!.seoDesc,
        k: "[keyword set from the SEO audit — not yet assigned]",
      }}
    >
      {blocks.map((b) => <Block {...b} />)}
    </Prototype>
  )
}
