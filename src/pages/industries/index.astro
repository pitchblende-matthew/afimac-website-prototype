/**
 * INDUSTRIES HUB — live on afimacglobal.com, replicated here section for
 * section from the published page, the same way the Overview is.
 *
 * Source: /solutions/critical-situation-travel-labor/industries/
 */
import Prototype from "../../layouts/Prototype.astro";
import Block from "../../components/Block.astro";
import { u } from "../../lib/base";
import { B } from "../../data/nav";
import { INDUSTRIES, EXISTING, INDUSTRY_ORDER } from "../../data/industries";
import type { Block as BlockType } from "../../lib/types";

/** The seven tiles as the live page orders them, plus the one that isn't there. */
const TILES = INDUSTRY_ORDER.map((slug) => {
  const built = INDUSTRIES[slug];
  const existing = EXISTING[slug];
  return {
    slug,
    label: existing?.label ?? built.short,
    live: Boolean(existing) || slug === "automotive" || slug === "food-beverage",
    route: `/industries/${slug}`,
  };
});

const LIVE_TILES = TILES.filter((t) => t.live);

// Table rows are built here rather than inline: nesting a template literal
// three deep inside a block's `h` string trips the Astro frontmatter parser.
const UPDATE_ROWS = INDUSTRY_ORDER.map((slug) => {
  const built = INDUSTRIES[slug];
  const ex = EXISTING[slug];
  const label = ex ? ex.label : built.short;
  const livecell = ex || built.liveH1 ? "Live" : "<i>None — new page</i>";
  const href = u("/industries/" + slug);
  const update = built
    ? '<a href="' + href + '">Wireframed, copy outstanding →</a>'
    : "Not started";
  return `<tr><th>${label}</th><td>${livecell}</td><td class="hl">${update}</td></tr>`;
}).join("");

const SEO_ROWS = Object.values(EXISTING)
  .map((e) => {
    const n = e.seoTitle.replace(/&amp;/g, "&").length;
    const flag = n < 50 || n > 60 ? " ⚠" : "";
    return `<tr><th>${e.label}</th><td>${e.seoTitle}</td><td class="hl">${n}${flag}</td></tr>`;
  })
  .join("");

