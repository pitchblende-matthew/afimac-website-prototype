import { LIVE_HUB, LIVE_CREDIBILITY_BODY, LIVE_COUNTERS } from "../../data/live-industries";
import { B } from "../../data/nav";
import { INDUSTRIES, EXISTING, INDUSTRY_ORDER, INDUSTRY_REDIRECTS } from "../../data/industries";
import { INDUSTRY_COPY } from "../../data/industry-copy";
import { STAT_BAND } from "../../lib/industry-page";
import type { Block as BlockType } from "../../lib/types";

/**
 * All ten industries, in the order the cluster uses.
 *
 * `live` means a visitor can read this industry on afimacglobal.com today —
 * which for Chemicals and Oil & Gas means under the slug the split retires,
 * not under their own. Looking EXISTING up by the new slug therefore misses
 * them, and the grid rendered five tiles where the live page carries seven.
 * The redirect map is the thing that knows, so ask it rather than the slug.
 */
/** New slug -> the old slug it still answers at, for the two split pages. */
const OLD_SLUG_FOR: Record<string, string> = Object.fromEntries(
  Object.entries(INDUSTRY_REDIRECTS).map(([from, r]) => [r.to, from]),
);

/**
 * Automotive and Food & Beverage are live but have no EXISTING record, because
 * that map holds the pages whose live copy was captured and those two were
 * rewritten instead. Named here so the one definition covers them.
 */
const LIVE_WITHOUT_RECORD = ["automotive", "food-beverage"];

/** The single answer to "can a visitor read this industry today?". */
const isLive = (slug: string) =>
  Boolean(EXISTING[slug]) || Boolean(OLD_SLUG_FOR[slug]) || LIVE_WITHOUT_RECORD.includes(slug);

const TILES = INDUSTRY_ORDER.map((slug) => {
  const built = INDUSTRIES[slug];
  const existing = EXISTING[slug];
  return {
    slug,
    label: existing?.label ?? built.short,
    live: isLive(slug),
    route: `/industries/${slug}`,
  };
});

const LIVE_TILES = TILES.filter((t) => t.live);
const NEW_TILES = TILES.filter((t) => !t.live);

/** Which industries have a deck behind them, for the update table's note. */
const WITH_COPY = INDUSTRY_ORDER.filter((slug) => INDUSTRY_COPY[slug]);
const WITHOUT_COPY = INDUSTRY_ORDER.filter((slug) => !INDUSTRY_COPY[slug]);

// Table rows are built here rather than inline: nesting a template literal
// three deep inside a block's `h` string trips the Astro frontmatter parser.
const UPDATE_ROWS = INDUSTRY_ORDER.map((slug) => {
  const built = INDUSTRIES[slug];
  const ex = EXISTING[slug];
  const label = ex ? ex.label : built.short;
  // Same trap as the tile grid: a split page is live, but recorded under the
  // slug it is moving away from, so EXISTING[slug] does not find it. Say which
  // URL it answers at rather than calling it a new page.
  const old = OLD_SLUG_FOR[slug];
  const livecell = old
    ? `Live at <code>/${old}/</code>`
    : isLive(slug)
      ? "Live"
      : "<i>None — new page</i>";
  const href = u("/industries/" + slug);
  // Logistics is the one page with no deck behind it. It is not untouched —
  // its copy is authored in the page itself rather than in INDUSTRY_COPY — so
  // do not let the absence of a deck entry read as "nothing written".
  const update = INDUSTRY_COPY[slug]
    ? '<a href="' + href + '">Deck copy written →</a>'
    : '<a href="' + href + '">Copy written in the page →</a>';
  return `<tr><th>${label}</th><td>${livecell}</td><td class="hl">${update}</td></tr>`;
}).join("");

const SEO_ROWS = Object.values(EXISTING)
  .map((e) => {
    const n = e.seoTitle.replace(/&amp;/g, "&").length;
    const flag = n < 50 || n > 60 ? " ⚠" : "";
    return `<tr><th>${e.label}</th><td>${e.seoTitle}</td><td class="hl">${n}${flag}</td></tr>`;
  })
  .join("");

