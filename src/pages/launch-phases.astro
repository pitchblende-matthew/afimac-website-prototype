---
/**
 * LAUNCH PHASES — internal working page, not part of the site IA.
 *
 * The rollout order is the client's. Everything else on this page is derived
 * from src/data/nav.ts rather than written by hand, so the readiness columns
 * cannot drift from the build status shown in the sub-nav.
 */
import Prototype from "../layouts/Prototype.astro";
import Block from "../components/Block.astro";
import { phaseAudit, WORK_SHORT, type Work } from "../data/nav";
import type { Block as BlockType } from "../lib/types";

const audit = phaseAudit();
const ORDER: Work[] = ["settled", "ready", "partial", "todo"];

/** Phases that still put a nav slot over a page that does not exist. */
const blocked = audit.filter((p) => p.hollow.length);

const workCell = (w: Record<Work, number>) =>
  ORDER.filter((k) => w[k]).map((k) => `${w[k]} ${WORK_SHORT[k]}`).join(" · ") || "—";

const rows = audit
  .map(
    (p) => `<tr>
   <th>Phase ${p.n}<br><span style="font-weight:400;color:var(--spec)">${p.name}</span></th>
   <td>${p.entries.length ? `+${p.entries.length}` : "—"}</td>
   <td>${p.cumulative}</td>
   <td>${workCell(p.work)}</td>
   <td class="${p.hollow.length ? "h" : "ok"}">${p.hollow.length ? `${p.hollow.length} hollow` : "none"}</td>
  </tr>`,
  )
  .join("");

const phaseBlocks: BlockType[] = audit.map((p) => ({
  cls: p.n % 2 ? "wash" : undefined,
  n: `PHASE ${p.n} · ${p.name.toUpperCase()}`,
  h: `
  <h2><span class="pchip${p.n === 0 ? " now" : ""}">${p.n}</span>${p.name}</h2>
  <p class="lead">${p.adds}</p>
  ${
    p.entries.length
      ? `<div class="tscroll"><table class="cmp"><thead><tr><th>Page</th><th>Route</th><th class="hl">Status</th></tr></thead><tbody>${p.entries
          .map(
            (e) => `<tr><th>${e.label}</th><td><code>${e.route}</code></td><td class="hl">${
              e.live ? "Live · update" : WORK_SHORT[e.work]
            }</td></tr>`,
          )
          .join("")}</tbody></table></div>`
      : `<div class="note" style="margin-top:0">Nothing is added here — this is the starting point. The Overview and the seven industry pages are already live; what does not exist is anything tying them together.</div>`
  }
  ${
    p.hollow.length
      ? `<div class="note stop"><b>${p.hollow.length} nav slot${p.hollow.length > 1 ? "s" : ""} here point${
          p.hollow.length > 1 ? "" : "s"
        } at a page that is neither live nor started.</b> ${p.hollow
          .map((e) => `<code>${e.route}</code>`)
          .join(" · ")} — ${
          p.hollow.length > 1 ? "these pages have" : "this page has"
        } no copy and no live URL to fall back on. Either write ${
          p.hollow.length > 1 ? "them" : "it"
        } before this phase ships, or hold the slot${p.hollow.length > 1 ? "s" : ""} back to a later one.</div>`
      : ""
  }`,
  spec: `Preview it: set the launch phase to ${p.n} in the pink bar above, then use the sub-nav.`,
}));

const blocks: BlockType[] = [
  {
    n: "THE ROLLOUT",
    h: `
  <h1>Launch phases</h1>
  <p class="lead">The CSTL section does not ship in one go. It arrives as six steps, each one adding to the last. This page is the plan and a readiness check against it — <b>the phase order is the client's; the status columns are read out of the build data</b>, so they cannot drift from the dots in the sub-nav.</p>
  <div class="tscroll"><table class="cmp phasetable"><thead><tr><th>Phase</th><th>Adds</th><th>Nav total</th><th>Build status of what it adds</th><th class="hl">Risk</th></tr></thead><tbody>${rows}</tbody></table></div>
  <div class="note"><b>“Hollow” means a nav slot pointing at a page that is neither live nor written.</b> A slot over a live page is fine even when the CSTL rewrite has not started — the link still lands somewhere real, and that is why Phase 1 carries five unstarted pages and no risk. A slot over a page that does not exist is a dead end.</div>
  <div class="note"><b>Not the four deployment phases.</b> Assessment, Mobilization, Deployment and Demobilization describe an engagement. These describe the rollout of this section. Same word, unrelated things — worth keeping the labels distinct in anything client-facing.</div>`,
    spec: `Use the launch-phase buttons in the pink bar to preview the sub-nav at each step. The choice persists across pages.`,
  },

  {
    cls: "sky",
    n: "WHERE THE RISK IS NOW",
    h: `
  <div class="g2">
   <div>
    <h2>${blocked.length ? `${blocked.length} phase${blocked.length > 1 ? "s" : ""} still carry a dead end` : "Every phase has somewhere to land"}</h2>
    <p class="lead">${
      blocked.length
        ? `A hollow slot is a nav entry pointing at a page that is neither live nor written. ${blocked
            .map((p) => `<b>Phase ${p.n}</b> has ${p.hollow.length} (${p.hollow.map((e) => `<code>${e.route}</code>`).join(", ")})`)
            .join("; ")}.`
        : `No phase puts a nav slot over a page that does not exist. The rollout order can stand as written.`
    }</p>
    ${
      blocked.length
        ? `<p>Everything else is clear. Write ${blocked.length > 1 ? "those pages" : "that page"} before ${blocked.length > 1 ? "their phases" : "its phase"} ships, or hold the slot${blocked.length > 1 ? "s" : ""} back a phase — a dropdown with a dead link reads as a broken site rather than one under construction.</p>`
        : `<p>That was not true a moment ago. This block reads the build data rather than restating a judgement, so it changes as the copy lands.</p>`
    }
   </div>
   <div>
    <h3>The shape to watch</h3>
    <p>Phase 4 now carries three fully written child pages — White Papers, Case Studies and Sales Sheets — hanging off a Resources hub with no approved copy of its own. <b>The leaves are ready and the branch is not.</b> Either write the hub, or let one of the three children serve as the landing page and drop the hub from the nav.</p>
    <div class="note stop" style="margin-top:22px"><b>Written is not the same as shippable.</b> Case Studies needs client permissions before four of its five rows can run, and Sales Sheets has no finished asset behind any of its five downloads. Those are asset problems, not copy problems, and this table cannot see them — read each page for its own blockers.</div>
   </div>
  </div>`,
    spec: `Derived from src/data/nav.ts. The earlier version of this block hardcoded a recommendation and went stale within a day of the copy landing; this one cannot.`,
  },

  ...phaseBlocks,
];
---

<Prototype
  title="Launch phases"
  crumb="Prototype › Launch phases"
  url="(internal — not a site page)"
  status="build"
>
  {blocks.map((b) => <Block {...b} />)}
</Prototype>
