---
/**
 * OPTION H, IN THE HEADER — internal working page, not part of the site IA.
 *
 * /nav-options shows the mega menu against a row of placeholder bar items,
 * which is enough to test the panel but not enough to judge it as a header.
 *
 * Here the menu is in the header rather than mocked in the body: the layout's
 * `megaNav` prop replaces the five nav items — Home, Solutions, Insights,
 * About, Contact — and keeps the real AFIMAC logo and social icons either
 * side. Everything below is the Automotive page's own deck copy, unchanged.
 */
import Prototype from "../layouts/Prototype.astro";
import Block from "../components/Block.astro";
import MegaNavH from "../components/MegaNavH.astro";
import { u } from "../lib/base";
import { INDUSTRY_COPY } from "../data/industry-copy";
import { stationFlow } from "../lib/wireframe";
import type { Block as BlockType } from "../lib/types";

const p = INDUSTRY_COPY.automotive;

const blocks: BlockType[] = [
  {
    cls: "dark",
    n: "OPTION H · ON A REAL PAGE",
    h: `
  <h1>Option H as the site header</h1>
  <p class="lead">The menu is in the header at the top of this page, not mocked in the body. It has replaced the five nav items — <i>Home, Solutions, Insights, About, Contact</i> — and keeps the AFIMAC logo and social icons either side, as on every other page.</p>
  <p class="lead">Everything below is the <a href="${u("/industries/automotive")}">Automotive</a> page's own copy, unchanged.</p>
  <p class="sub"><b>The menu is live, at full size.</b> Move through <i>Solutions</i> &rarr; a service area &rarr; a section. It works on hover, click and keyboard.</p>`,
    spec: `The layout's <code>megaNav</code> prop swaps the header's nav list for <code>megaNavDown()</code> from <code>src/lib/mega-nav.ts</code> — the same function <a href="${u("/nav-options")}">/nav-options</a> renders, not a copy, so the two stay in step.`,
  },
];

const after: BlockType[] = [
  {
    n: "WHAT TO LOOK AT",
    h: `
  <h2>What to look at</h2>
  <div class="g3" style="margin-top:22px">
    <div><div class="catbar mfg">How far it reaches</div><p>Open the menu from the real header. <b>The panel covers the sub-nav, the breadcrumb and most of the hero.</b> On a 1366&times;768 laptop it reaches further still. That is the trade for the width H needs.</p></div>
    <div><div class="catbar mfg">Whether you lose your place</div><p>Step to the third tier and look at what is still visible of the two above it. This is the main difference between G and H, and it only shows on a real page.</p></div>
    <div><div class="catbar mfg">What it does to the page below</div><p>The header is a band on every page on the site. <b>Note how much vertical space it takes before content starts</b> — on mobile that is the whole first screen.</p></div>
  </div>
  <div class="note"><b>The CSTL sub-nav is still underneath it.</b> That is the prototype's own, and how you get back out of this page. It also raises the question option H has to answer: <b>if the header carries the whole section, most of that sub-nav is already in the panel above it.</b> Both probably cannot stay.</div>
  <div class="note stop"><b>This page does not prove the mobile case.</b> Narrow the window: below 900px the panel falls into a stacked list that would live inside a burger menu. <b>That burger menu is not designed</b>, and it is a second pattern to build and test on every page of the site.</div>`,
    spec: `<b>Elementor:</b> one HTML widget in the header template, plus state. It touches every page on the site, so it needs its own test pass rather than riding on the CSTL phases.`,
  },
  {
    cls: "wash",
    n: "BLOCK 02 · THE LABOR GAP — AS WRITTEN",
    h: `
  <h2>${p.gapH2}</h2>
  <p class="lead">${p.gapBody}</p>
  <div class="g2" style="margin-top:22px">
    <div class="duo"><div class="duohead">${p.situationsH3}</div>
      <div class="duobody"><ul class="check">${p.situations.map((x) => `<li>${x}</li>`).join("")}</ul></div></div>
    <div class="duo risk"><div class="duohead">${p.risksH3}</div>
      <div class="duobody"><ul class="warn">${p.risks.map((x) => `<li>${x}</li>`).join("")}</ul></div></div>
  </div>`,
    spec: `Approved Automotive deck copy, rendered from <code>INDUSTRY_COPY</code> — the same source the real page uses.`,
  },
  {
    n: "BLOCK 05 · THE CREWS — AS WRITTEN",
    h: `
  <h2>${p.rolesH2}</h2>
  <p class="lead">${p.rolesBody}</p>
  ${stationFlow({ eyebrow: "Body shop to shipping", stations: p.stations })}`,
    spec: `Seven stations, ${p.stations.reduce((n, s) => n + s.roles.length, 0)} roles. See <a href="${u("/modules-by-industry")}">modules by industry</a> for how far this module is written across the others.`,
  },
  {
    cls: "blue",
    n: "BLOCK 07 · THE NUMBERS — AS WRITTEN",
    h: `
  <h2>${p.numbersH2}</h2>
  <p class="lead">${p.numbersBody}</p>
  <div class="g3" style="margin-top:22px">${p.stats
    .map(([fig, lab]) => `<div><div class="stat">${fig}</div><p>${lab}</p></div>`)
    .join("")}</div>`,
    spec: `See <a href="${u("/stat-modules")}">the stat module</a> for what else could go in this band.`,
  },
];
---

<Prototype
  title="Option H in the header"
  crumb="Option H, in the header"
  url="Internal — not a site page"
  status="build"
  megaNav
>
  <MegaNavH scriptOnly />
  {blocks.map((b) => <Block {...b} />)}
  {after.map((b) => <Block {...b} />)}
</Prototype>
