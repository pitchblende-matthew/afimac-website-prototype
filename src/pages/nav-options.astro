---
/**
 * NAV OPTIONS — internal working page, not part of the site IA.
 *
 * Six ways to handle the Roles slot, each rendered as a sub-nav you can
 * actually open rather than a picture of one. The bars are mock markup under
 * their own `no-` class prefix: nothing here touches the real SubNav, so a
 * reviewer can play with all six without changing what the rest of the
 * prototype shows.
 */
import Prototype from "../layouts/Prototype.astro";
import Block from "../components/Block.astro";
import { u } from "../lib/base";
import { BY_FUNCTION, BY_INDUSTRY, FAMILY_STATS, LABEL_CANDIDATES, OPTIONS, ROLE_FAMILIES, ROLE_PAGES, SOLUTION_TIERS, type RoleGroup, type RoleLink, type TierSection, type TierSolution } from "../data/nav-options";
import type { Block as BlockType } from "../lib/types";

/** The four slots that are not under discussion, shown so the bar reads true. */
const FIXED = ["Overview", "How It Works", "Industries"];

const link = (r: RoleLink): string =>
  `<a href="${u(r.route)}"${r.written ? "" : ' class="no-todo"'}>${r.label}${r.written ? "" : " <span>no copy yet</span>"}</a>`;

/** A plain dropdown: one column of links. */
const flat = (): string => `<div class="no-dd">${ROLE_PAGES.map(link).join("")}</div>`;

/** One panel, links under group headings — no second level. */
const grouped = (groups: RoleGroup[]): string =>
  `<div class="no-dd no-wide">${groups
    .map(
      (g) =>
        `<div class="no-col"><div class="no-colhead">${g.label}</div><p class="no-gist">${g.gist}</p>${g.roles
          .map(link)
          .join("")}</div>`,
    )
    .join("")}</div>`;

/** A true nested flyout: category rows, each opening a panel beside it. */
const flyout = (groups: RoleGroup[]): string =>
  `<div class="no-dd">${groups
    .map(
      (g) =>
        `<div class="no-sub"><a href="${u("/roles")}" class="no-subhead">${g.label}<span class="no-caret">›</span></a><div class="no-flyout">${g.roles
          .map(link)
          .join("")}</div></div>`,
    )
    .join("")}</div>`;

/** Categories on the left, roles on the right, one panel, no nesting. */
const twopane = (groups: RoleGroup[]): string =>
  `<div class="no-dd no-pane">
    <div class="no-rail">${groups
      .map((g, i) => `<button type="button" class="no-railbtn${i === 0 ? " on" : ""}" data-pane="${i}">${g.label}<span class="no-caret">›</span></button>`)
      .join("")}</div>
    <div class="no-panes">${groups
      .map(
        (g, i) =>
          `<div class="no-panebody${i === 0 ? " on" : ""}" data-pane="${i}"><p class="no-gist">${g.gist}</p>${g.roles.map(link).join("")}</div>`,
      )
      .join("")}</div>
  </div>`;

/**
 * One mock sub-nav bar. `slot` is the markup for the slot under discussion;
 * pass an empty string to show the bar without it.
 */
const bar = (slot: string): string =>
  `<div class="no-bar">
    <span class="no-mark">Travel Labor</span>
    ${FIXED.map((f) => `<div class="no-item">${f}${f === "Overview" ? "" : '<span class="no-caret">▾</span>'}</div>`).join("")}
    ${slot}
    <a class="no-cta">Get in Touch</a>
  </div>`;

/** The slot under discussion, open-on-hover, with its dropdown inside. */
const slot = (label: string, dd: string, extra = ""): string =>
  `<div class="no-item no-has${extra ? " " + extra : ""}"><span class="no-live">${label}</span><span class="no-caret">▾</span>${dd}</div>`;

/** Compact link for the mega panel — muted when unwritten, but no trailing note. */
const mlink = (r: RoleLink): string =>
  `<a href="${u(r.route)}"${r.written ? "" : ' class="no-todo"'}>${r.label}</a>`;

/**
 * Tier 3 — what is inside one section.
 *
 * Three shapes, because the sections are not alike: a two-column list of
 * pages, the crews under their capability headings, or — for the four
 * solution areas this build does not cover — a line saying so rather than a
 * fake list.
 */
const tierPages = (sec: TierSection): string => {
  if (sec.families)
    return `<div class="no-tierbody">${sec.families
      .map(
        (f) =>
          `<div class="no-fam"><a class="no-famname" href="${u(f.pages[0].route)}">${f.label}</a><p class="no-famroles">${f.roles.join(
            " · ",
          )}</p></div>`,
      )
      .join("")}</div>`;
  if (sec.groups)
    return `<div class="no-tierbody">${sec.groups
      .map(
        (g) =>
          `<div class="no-rolegrp"><div class="no-grpname">${g.label}</div><p class="no-grpgist">${g.gist}</p><div class="no-rolerow">${g.roles
            .map(mlink)
            .join('<span class="no-sep">·</span>')}</div></div>`,
      )
      .join("")}</div>`;
  if (sec.pages)
    return `<div class="no-tierbody"><div class="no-pagelist">${sec.pages.map(mlink).join("")}</div></div>`;
  return `<div class="no-tierbody"><p class="no-empty">This prototype is the CSTL section only. On the live site this tier opens the pages under <b>${sec.label}</b> — the panel shape is the same, the content is not written here.</p></div>`;
};

/**
 * The primary-nav mock and its tiered panel.
 *
 * Three rails left to right: solution, section, pages. Every rail is a
 * button, so the cascade answers to click and keyboard as well as hover —
 * the difference between this and the hover-chain in option C.
 */
const megabar = (): string =>
  `<div class="no-top">
    <span class="no-logo">AFIMAC</span>
    <div class="no-titem">Home</div>
    <div class="no-titem no-hasmega is-mega"><span class="no-live">Solutions</span><span class="no-caret">▾</span>
      <div class="no-mega no-tier">
        <div class="no-tiergrid">
          <div class="no-rail">
            <div class="no-railhead">Solution</div>
            ${SOLUTION_TIERS.map(
              (so, i) =>
                `<button type="button" class="no-railbtn${i === 0 ? " on" : ""}" data-sol="${i}" data-first="${i}-0">${so.label}<span class="no-caret">›</span></button>`,
            ).join("")}
          </div>
          <div class="no-rail no-rail2">
            <div class="no-railhead">Section</div>
            ${SOLUTION_TIERS.map(
              (so, i) =>
                `<div class="no-secs${i === 0 ? " on" : ""}" data-sol="${i}">${so.sections
                  .map(
                    (sec, j) =>
                      `<button type="button" class="no-railbtn${j === 0 ? " on" : ""}" data-sec="${i}-${j}">${sec.label}<span class="no-caret">›</span></button>`,
                  )
                  .join("")}</div>`,
            ).join("")}
          </div>
          <div class="no-tierpages">
            ${SOLUTION_TIERS.map((so, i) =>
              so.sections
                .map(
                  (sec, j) =>
                    `<div class="no-pagepane${i === 0 && j === 0 ? " on" : ""}" data-pane="${i}-${j}"><div class="no-colhead">${sec.label}</div><p class="no-grpgist">${sec.gist}</p>${tierPages(sec)}</div>`,
                )
                .join(""),
            ).join("")}
          </div>
          <div class="no-tierpromo">
            <div class="no-promo">
              <b>Critical labor situation?</b>
              <p>Crews on your floor in days, not weeks.</p>
              <a class="no-pcta" href="${u("/get-in-touch")}">Get in Touch</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="no-titem">Insights</div>
    <div class="no-titem">About<span class="no-caret">▾</span></div>
    <div class="no-titem">Contact</div>
  </div>`;

/**
 * The same three tiers, stacked into full-width bands that open downward.
 * Shares the data, the button semantics and the cascade script with megabar —
 * only the arrangement differs, which is the point of showing both.
 */
const megabarDown = (tiers: TierSolution[] = SOLUTION_TIERS): string =>
  `<div class="no-top">
    <span class="no-logo">AFIMAC</span>
    <div class="no-titem">Home</div>
    <div class="no-titem no-hasmega is-mega"><span class="no-live">Solutions</span><span class="no-caret">▾</span>
      <div class="no-mega no-tier no-tierdown">
        <div class="no-band">
          <div class="no-bandhead">Solution</div>
          <div class="no-bandbody"><div class="no-tabs">${tiers.map(
            (so, i) =>
              `<button type="button" class="no-tab${i === 0 ? " on" : ""}" data-sol="${i}" data-first="${i}-0">${so.label}</button>`,
          ).join("")}</div></div>
        </div>
        <div class="no-band no-band2">
          <div class="no-bandhead">Section</div>
          <div class="no-bandbody">${tiers.map(
            (so, i) =>
              `<div class="no-secs${i === 0 ? " on" : ""}" data-sol="${i}"><div class="no-tabs">${so.sections
                .map(
                  (sec, j) =>
                    `<button type="button" class="no-tab${j === 0 ? " on" : ""}" data-sec="${i}-${j}">${sec.label}</button>`,
                )
                .join("")}</div></div>`,
          ).join("")}</div>
        </div>
        <div class="no-band no-bandpages">
          <div class="no-downgrid">
            <div class="no-downmain">${tiers.map((so, i) =>
              so.sections
                .map(
                  (sec, j) =>
                    `<div class="no-pagepane${i === 0 && j === 0 ? " on" : ""}" data-pane="${i}-${j}"><div class="no-colhead">${sec.label}</div><p class="no-grpgist">${sec.gist}</p>${tierPages(sec)}</div>`,
                )
                .join(""),
            ).join("")}</div>
            <div class="no-promo">
              <b>Critical labor situation?</b>
              <p>Crews on your floor in days, not weeks.</p>
              <a class="no-pcta" href="${u("/get-in-touch")}">Get in Touch</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="no-titem">Insights</div>
    <div class="no-titem">About<span class="no-caret">▾</span></div>
    <div class="no-titem">Contact</div>
  </div>`;

/** The same menu with the roles tier rebuilt around families. */
const FAMILY_TIERS: TierSolution[] = SOLUTION_TIERS.map((so, i) =>
  i === 0
    ? {
        ...so,
        sections: so.sections.map((sec) =>
          sec.label === "Who We Deploy"
            ? { ...sec, gist: "Six families, with the job titles as illustration", groups: undefined, families: ROLE_FAMILIES }
            : sec,
        ),
      }
    : so,
);

const familyRows = ROLE_FAMILIES.map(
  (f) =>
    `<tr><th>${f.label}</th><td>${f.roles.join(", ")}</td><td class="hl">${f.pages
      .map(
        (pg) =>
          `<a href="${u(pg.route)}">${pg.label}</a>${pg.written ? "" : ' <span style="color:var(--spec)">· no copy yet</span>'}`,
      )
      .join("<br>")}</td></tr>`,
).join("");

const opt = (id: string) => OPTIONS.find((o) => o.id === id)!;

const tradeoffs = (id: string): string => {
  const o = opt(id);
  return `<div class="g2" style="margin-top:22px">
   <div class="duo"><div class="duohead">What it buys</div><div class="duobody"><p style="margin:0">${o.buys}</p></div></div>
   <div class="duo risk"><div class="duohead">What it costs</div><div class="duobody"><p style="margin:0">${o.costs}</p></div></div>
  </div>`;
};

const candidateRows = LABEL_CANDIDATES.map(
  (c) => `<tr><th>${c.label}</th><td>${c.note}</td></tr>`,
).join("");

const summaryRows = OPTIONS.map(
  (o) =>
    `<tr><th>${o.n} · ${o.title}</th><td>${o.label}</td><td>${o.nested ? "Yes" : "No"}</td><td class="hl">${o.costs.split(".")[0]}.</td></tr>`,
).join("");

const blocks: BlockType[] = [
  {
    cls: "dark",
    n: "NAV OPTIONS · THE ROLES SLOT",
    h: `
  <h1>Eight ways to handle the Roles slot</h1>
  <p class="lead">The client does not want a sub-nav entry that reads as a list of job titles. Two directions were asked for — rename the slot, or give it a second level that categorises the roles — and both are below, with the versions either side of them for comparison.</p>
  <p class="lead"><b>A to F all change the CSTL sub-nav. G and H do not.</b> They move the whole question up to the primary nav as a full-width mega menu — a site-wide change rather than a section one. <b>G and H are the same menu in two arrangements</b>, tiers running across and tiers running down; they are last on the page because they are the largest, not because they are the least likely.</p>
  <p class="sub"><b>Every bar on this page is live.</b> Hover or tab into the highlighted slot to open it. Nothing here changes the real sub-nav at the top of the window.</p>`,
    spec: `Internal working page. Not in the IA, not in the sub-nav, and nothing on it ships as-is.`,
  },

  {
    n: "WHAT IS ACTUALLY IN THERE",
    h: `
  <h2>Eight pages, and only the way in is in question</h2>
  <p class="lead">Seven role pages are written and one — Warehouse &amp; Logistics — is on the build sheet with no copy deck. None of the options below adds or removes a page. They change the label above the list, the shape of the list, or both.</p>
  <div class="g3" style="margin-top:24px">${BY_FUNCTION.map(
    (g) =>
      `<div><div class="catbar mfg">${g.label}</div><ul class="check">${g.roles
        .map((r) => `<li>${r.label}${r.written ? "" : " <span style=\"color:var(--spec)\">· no copy yet</span>"}</li>`)
        .join("")}</ul></div>`,
  ).join("")}</div>
  <div class="note"><b>This grouping is the one that divides cleanly.</b> Each page sits in exactly one category. The industry grouping used in option D does not have that property, which is the main thing separating the two.</div>`,
    spec: `Drawn from the eight routes in the roles hub, grouped in src/data/nav-options.ts.`,
  },

  {
    cls: "wash",
    n: "OPTION A · RENAME THE SLOT",
    h: `
  <h2>A · Rename the slot, keep the flat list</h2>
  <p class="lead">The cheapest change on the page: one word in the Elementor header template. The dropdown is untouched.</p>
  ${bar(slot(opt("rename").label, flat(), "is-focus"))}
  <h3 style="margin-top:34px">Label candidates</h3>
  <div class="tscroll"><table class="cmp"><tbody>${candidateRows}</tbody></table></div>
  ${tradeoffs("rename")}`,
    spec: `<b>Elementor:</b> rename the menu item. No new pages, no new URLs, no redirect work.`,
  },

  {
    n: "OPTION B · ONE PANEL, GROUPED",
    h: `
  <h2>B · One panel, roles grouped under headings</h2>
  <p class="lead">Still one level — the panel just gets wider and the eight links sit under three headings. The headings carry the argument the bare list could not.</p>
  ${bar(slot(opt("grouped").label, grouped(BY_FUNCTION), "is-focus no-wideslot"))}
  ${tradeoffs("grouped")}
  <div class="note"><b>This is the one that solves the stated problem with the least new machinery.</b> It stops reading as vacancies without introducing an interaction the bar does not already have.</div>`,
    spec: `<b>Elementor:</b> a mega-menu dropdown on one item. Most themes support this natively; otherwise one HTML widget in the header template.`,
  },

  {
    cls: "wash",
    n: "OPTION C · SECOND LEVEL, BY FUNCTION",
    h: `
  <h2>C · A further dropdown, categorised by what the crew does</h2>
  <p class="lead">The brief as asked: three categories, each opening a flyout of its own. Hover a category below to see it.</p>
  ${bar(slot(opt("flyout-function").label, flyout(BY_FUNCTION), "is-focus"))}
  ${tradeoffs("flyout-function")}
  <div class="note stop"><b>Try this one on a phone before signing it off.</b> A flyout that opens on hover has no equivalent on touch: the first tap opens the category, and the second has to find a panel that may have opened off the side of the screen. <b>Option E is the same structure without that problem.</b></div>`,
    spec: `<b>Elementor:</b> a third-level menu. Supported, but the mobile behaviour needs testing on a real device, not the editor preview.`,
  },

  {
    n: "OPTION D · SECOND LEVEL, BY INDUSTRY",
    h: `
  <h2>D · A further dropdown, categorised by industry</h2>
  <p class="lead">Same mechanic as C, categorised the way a buyer arrives — by the plant they run rather than the job title they need.</p>
  ${bar(slot(opt("flyout-industry").label, flyout(BY_INDUSTRY), "is-focus"))}
  ${tradeoffs("flyout-industry")}
  <div class="note stop"><b>Count the repeats.</b> Forklift Operators appears under all three industries, Packaging Operations under two, Assemblers under two. <b>Twelve entries for eight pages.</b> The nav looks bigger than the site, and three routes lead to one URL — which is a canonical-tag question as well as a navigation one.</div>
  <div class="note"><b>It also duplicates the slot above it.</b> Industries is already in the bar, and each industry page already maps its own crews. This option puts the same three industries in the nav twice.</div>`,
    spec: `<b>Elementor:</b> as option C. <b>Decide the canonical URL for each role page first</b> — the duplication is in the nav, not the content, but search engines see the links.`,
  },

  {
    cls: "wash",
    n: "OPTION E · TWO-PANE PANEL",
    h: `
  <h2>E · Categories on the left, roles on the right</h2>
  <p class="lead">What option C is trying to be, in one panel instead of two. Click or tab a category on the left and the roles swap on the right — no nesting, so nothing has to be hovered twice.</p>
  ${bar(slot(opt("twopane").label, twopane(BY_FUNCTION), "is-focus no-wideslot"))}
  ${tradeoffs("twopane")}
  <div class="note"><b>The same panel works by industry.</b> The rail is just a list — swapping the three categories for Automotive, Food &amp; Beverage and Logistics takes the content from option D without its hover problem. <b>The duplication would come with it, though.</b></div>`,
    spec: `<b>Elementor:</b> one HTML widget in the header template, scoped like the line-map widgets already in the build.`,
  },

  {
    n: "OPTION F · NO SLOT AT ALL",
    h: `
  <h2>F · Remove the slot and let Industries carry the roles</h2>
  <p class="lead">The bar drops to four items. Nothing is deleted — the role pages stay where they are, reached from the station maps already on each industry page.</p>
  ${bar("")}
  ${tradeoffs("fold")}
  <div class="note stop"><b>This is on the page because it is the honest end of the argument, not because we recommend it.</b> Eight written pages would have no nav entry, and the role pages are the deepest keyword surface in the section — they are the pages that answer "CNC operator staffing" rather than "travel labor".</div>`,
    spec: `Would also return the Roles phase to the plan as unused — see <a href="${u("/launch-phases")}">launch phases</a>.`,
  },

  {
    cls: "wash",
    n: "OPTION G · MEGA MENU, TIERS ACROSS",
    h: `
  <h2>G · A tiered mega menu — tiers running across</h2>
  <p class="lead">Three levels inside one wide panel. Hover <b>Solutions</b> and the five service areas appear; step right into <b>Critical Situation Travel Labor</b> and its sections appear beside them; step right again and that section&rsquo;s pages fill the rest of the panel. Nothing opens on top of anything else — the panel is one surface and the tiers move across it.</p>
  <p class="sub"><b>All three rails are live.</b> Move across them, or tab through — every rail is a button, not a hover target.</p>
  ${megabar()}
  <h3 style="margin-top:34px">What the tiers buy</h3>
  <p>The CSTL section is <b>28 pages</b>. A single panel that showed all of them at once would be a wall; a dropdown that showed them one list at a time would be eight items deep. Tiering means <b>any page in the section is two steps from the header</b>, and the panel never shows more than one section&rsquo;s worth of links at a time — so there is room for the other four solution areas to grow the same way without the menu changing shape.</p>
  <h3 style="margin-top:26px">Why this answers the roles objection</h3>
  <p>A to E all try to make a list of eight job titles read as something other than a list of job titles — by renaming it, grouping it, or nesting it. <b>Here the roles stop being a dropdown at all.</b> <i>Who We Deploy</i> is a section you step into, alongside The Service, Industries and Resources, and inside it the crews sit under three capability headings on a wrapped line rather than stacked in a column. Same eight pages, same eight links — but nothing in the layout presents them as a list of openings.</p>
  ${tradeoffs("mega")}
  <div class="note"><b>The thing to insist on is that the tiers are buttons.</b> This is the same cascade option C has, and option C fails on touch because each level only opens on hover. The panel above opens its tiers on hover <b>and</b> on click <b>and</b> on keyboard focus — which costs nothing to build this way at the start and cannot be retrofitted cheaply once the header is built around hover.</div>
  <div class="note"><b>CSTL is the only area with pages behind it.</b> The other four carry their real sub-sections from the live site in the second rail, so the depth of the section is visible, but their third tier says so rather than inventing a list. <b>They need content written before this ships</b> — the header is shared by every page, so this cannot go live for one section alone.</div>
  <div class="note stop"><b>Check it at phone width before it goes further.</b> Three rails side by side have no touch equivalent: below 900px the whole thing has to become a stacked accordion inside a burger menu, which is a second pattern to design, build and test. <b>Narrow this window and the panel falls into that stacked state</b> so the thing that needs designing is visible rather than described.</div>
  <div class="note"><b>It puts the Roles argument on hold rather than settling it.</b> If the header carries the section this way, the CSTL sub-nav either shrinks to a few in-section links or goes away — and the slot A to F are arguing over goes with it.</div>`,
    spec: `<b>Elementor:</b> replaces the Solutions dropdown in the header template with a full-width tiered panel — one HTML widget plus a small amount of state, not a stock mega-menu. <b>Touches every page on the site</b>, so it needs its own test pass rather than riding on the CSTL phases. <b>Specify the tiers as click-and-keyboard from the outset</b>; a hover-only build is the version that fails review.`,
  },

  {
    n: "OPTION H · MEGA MENU, TIERS DOWN",
    h: `
  <h2>H · The same three tiers, stacked into bands</h2>
  <p class="lead">Identical content and identical steps to G — solution, section, pages — but the tiers are full-width bands that open downward rather than rails that run across. Pick along the top band and the one beneath it changes; pick there and the pages fill the band below that.</p>
  <p class="sub"><b>Both bands are live.</b> The panel grows as you move through it, which is the behaviour to judge.</p>
  ${megabarDown()}
  <h3 style="margin-top:34px">What running the tiers down changes</h3>
  <p>Every tier gets the whole width of the panel instead of a 230px rail. <b>Long names sit on one line</b> — &ldquo;Labor Dispute Security + Support&rdquo; wraps to two lines in G&rsquo;s first rail and does not here — and the third tier has room for four columns of pages rather than two, so the eight industries and the three crew groups each land on a single screen. It also reads in the order people scan: down the page, then across each band.</p>
  <h3 style="margin-top:26px">And what it costs</h3>
  <p>The panel grows downward as you go, so by the third tier it covers most of the window — and on a laptop screen <b>the choices you made in the first two bands can scroll out of sight</b> while you are reading the third. <b>G keeps all three tiers in view at a fixed height; H trades that for width.</b> That is the whole choice between them.</p>
  ${tradeoffs("mega-down")}
  <div class="note"><b>Nothing else differs.</b> Same pages, same grouping, same two steps to any page, and the same requirement that the tiers answer to click and keyboard as well as hover. If the mega-menu direction is agreed, <b>across-or-down is a layout decision rather than a structural one</b> — and it can be settled late, because the content behind both is identical.</div>`,
    spec: `<b>Elementor:</b> the same widget as G in a different arrangement. <b>Worth testing at 1366×768</b> — the laptop most buyers are on — since that is the height at which the third band starts pushing the first two off the top.`,
  },

  {
    cls: "wash",
    n: "ROLE FAMILIES · A DIFFERENT UNIT",
    h: `
  <h2>Families as the entry, job titles as illustration</h2>
  <p class="lead">The newer thinking: name the <b>family</b> in the nav and let the specific job titles sit underneath as illustration rather than as things you click. This is a change to <b>what the roles tier contains</b>, not to which option carries it — the same six families drop into B, E, G or H without altering any of them.</p>
  <div class="tscroll" style="margin-top:22px"><table class="cmp"><thead><tr><th>Potential role family</th><th>Illustrative roles</th><th class="hl">What exists behind it today</th></tr></thead><tbody>${familyRows}</tbody></table></div>
  <div class="note"><b>${FAMILY_STATS.families} families, ${FAMILY_STATS.titles} job titles, ${FAMILY_STATS.pages} pages.</b> The families and the pages line up almost exactly. The job titles do not — <b>most of them have no page behind them</b> and never had: there is no CNC Programmers page, no Reach Truck Operators page, no CIP Operators page.</div>
  <div class="note stop"><b>That is the decision this forces, and it is worth settling before anything is built.</b> If the job titles are <b>copy</b> — words sitting under a family name — then nothing new has to be written, the nav gets six entries instead of eight, and the objection is answered outright: a family with examples underneath cannot be mistaken for a list of openings. <b>If the job titles are links</b>, this is not a nav change at all; it is a request for roughly eighteen new pages.</div>
  <div class="note"><b>It also suggests the section is one page-merge away from tidy.</b> ${FAMILY_STATS.oneToOne} of the ${FAMILY_STATS.families} families are a single existing page wearing a better name. The other ${FAMILY_STATS.merging} each cover two: <b>Machining &amp; Precision Manufacturing</b> sits over CNC Operators <i>and</i> Machinists, and <b>Material Handling &amp; Warehouse Operations</b> sits over Forklift Operators <i>and</i> the unwritten Warehouse &amp; Logistics. If families become the nav entries, those are the two pairs to merge — which takes the section from eight role pages to six, and quietly removes the one page that still has no copy.</div>
  <h3 style="margin-top:34px">The families in the menu</h3>
  <p>Below is option H carrying families instead of capability groups. <b>Step into Who We Deploy to see it.</b> The family name is the link; the job titles under it are text. Everything else about the panel is unchanged — which is the point, since this swap works the same way in G, and in the smaller panels of B and E.</p>
  ${megabarDown(FAMILY_TIERS)}
  <div class="note"><b>Compare it with the same tier in option H above.</b> Three capability groups with a line of explanation each, against six families with their job titles spelled out. The families say more about what AFIMAC can staff; the capability groups read faster. <b>Both are a long way from the column of eight job titles that started this conversation.</b></div>`,
    spec: `The taxonomy is held in <code>ROLE_FAMILIES</code> in <code>src/data/nav-options.ts</code>, and the counts in the notes above are computed from it — so the table, the mock and the prose cannot fall out of step. <b>The links-or-copy decision is the one to take to the client;</b> everything else here follows from it.`,
