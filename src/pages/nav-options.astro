<script is:inline>
  /* The two-pane panel. Click or keyboard only — the rail is buttons, so it
     behaves the same on touch as on a desktop, which is the whole point of
     the option. */
  /* G — the tiered panel. Hover, click and focus all select, so the cascade
     behaves the same with a mouse, a finger and a keyboard. Picking a
     solution also picks its first section, so the third rail is never blank. */
  document.querySelectorAll(".no-tier").forEach((tier) => {
    const pick = (sol, sec) => {
      tier.querySelectorAll("[data-sol]").forEach((e) => e.classList.toggle("on", e.dataset.sol === sol));
      tier.querySelectorAll("[data-sec]").forEach((e) => e.classList.toggle("on", e.dataset.sec === sec));
      tier.querySelectorAll("[data-pane]").forEach((e) => e.classList.toggle("on", e.dataset.pane === sec));
    };
    const on = (el, fn) => ["mouseenter", "focus", "click"].forEach((ev) => el.addEventListener(ev, fn));
    tier.querySelectorAll("[data-first]").forEach((btn) =>
      on(btn, () => pick(btn.dataset.sol, btn.dataset.first)),
    );
    tier.querySelectorAll("[data-sec]").forEach((btn) =>
      on(btn, () => pick(btn.dataset.sec.split("-")[0], btn.dataset.sec)),
    );
  });

  document.querySelectorAll(".no-pane").forEach((pane) => {
    pane.querySelectorAll(".no-railbtn").forEach((btn) => {
      const show = () => {
        pane.querySelectorAll(".no-railbtn").forEach((b) => b.classList.toggle("on", b === btn));
        pane.querySelectorAll(".no-panebody").forEach((b) =>
          b.classList.toggle("on", b.dataset.pane === btn.dataset.pane),
        );
      };
      btn.addEventListener("click", show);
      btn.addEventListener("focus", show);
    });
  });
</script>
