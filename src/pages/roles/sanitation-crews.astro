const PHASES: [string, string][] = [
  ["ASSESSMENT · 1 TO 2 DAYS", "Map your sanitation program, rooms, shift windows &amp; site requirements, then finalize the deployment plan."],
  ["MOBILIZATION · 2 TO 3 DAYS", "Source and screen the crew from a 20,000+ talent network; credential and role checks, travel, housing &amp; site-specific safety onboarding."],
