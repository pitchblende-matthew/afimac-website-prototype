---
/**
 * THE STAT MODULE — internal working page, not part of the site IA.
 *
 * The stat band runs on every industry page and on the overview. Three
 * different versions of it are in use across the section, which the industry
 * template already flags.
 *
 * This page renders the band, puts the three versions side by side, and lists
 * candidate figures for it. Each candidate is graded by how easily AFIMAC
 * could source the number, since that decides which ones can ship.
 */
import Prototype from "../layouts/Prototype.astro";
import Block from "../components/Block.astro";
import { u } from "../lib/base";
import { INDUSTRY_COPY } from "../data/industry-copy";
import { LIVE_COUNTERS } from "../data/live-industries";
import type { Block as BlockType } from "../lib/types";

const auto = INDUSTRY_COPY.automotive;

/**
 * The band, as the deck writes it. `stacked` is for the three-way comparison,
 * where each version sits in a third of the width and a 3-across grid inside
 * that breaks the figures over two lines.
 */
const band = (stats: [string, string][], stacked = false): string =>
  `<div class="${stacked ? "statstack" : "g3"}" style="margin-top:${stacked ? 18 : 22}px">${stats
    .map(([fig, lab]) => `<div><div class="stat">${fig}</div><p>${lab}</p></div>`)
    .join("")}</div>`;

/** The four figures the June-05 package approved. */
const JUNE05: [string, string][] = [
  ["40+", "Years of experience"],
  ["20,000+", "Skilled laborers"],
  ["Within 72 hrs", "To a crew on site"],
  ["1–500+", "Scalable crew size"],
];

type Source = "have" | "pull" | "new";
const SOURCE_LABEL: Record<Source, string> = {
  have: "Already published",
  pull: "In a system — needs pulling",
  new: "Needs measuring first",
};

interface Candidate {
  fig: string;
  label: string;
  argues: string;
  from: string;
  source: Source;
}

/**
 * Candidate figures. `fig` shows the form the number would take, not a value
 * anyone has signed off. Each needs AFIMAC to supply or confirm it.
 */
const CANDIDATES: { group: string; gist: string; items: Candidate[] }[] = [
  {
    group: "Already approved — just not in this band",
    gist: "Two figures the June-05 package approved and this band drops. Nothing to source and nothing to decide. They carry the speed and scale claims.",
    items: [
      { fig: "Within 72 hrs", label: "To a crew on site", argues: "Speed. Why a buyer calls instead of recruiting.", from: "June-05 package; also the third bar of the speed comparison on every industry page.", source: "have" },
      { fig: "1–500+", label: "Scalable crew size", argues: "Answers “are we too small or too big for you”.", from: "June-05 package.", source: "have" },
    ],
  },
  {
    group: "Counted today, but the numbers never reach the page",
    gist: `The live credibility block runs four counters — ${LIVE_COUNTERS.join(" · ")} — that animate up from zero. <b>The figures are produced by script, so they are not in the page text at all:</b> not for search engines, not for a screen reader, not for anyone who opens the page before the script runs. The numbers exist but are not published.`,
    items: [
      { fig: "###", label: "Industry deployments", argues: "Depth of experience — that this is routine rather than a first.", from: "Live counter. The number is already approved — it just has to be written into the markup.", source: "pull" },
      { fig: "###", label: "Companies served", argues: "Breadth. Pairs with industries served.", from: "Live counter.", source: "pull" },
      { fig: "###", label: "Laborers provided", argues: "Work done, as distinct from the 20,000+, which is network size.", from: "Live counter. <b>Label it clearly against 20,000+</b>, or the two read as one claim made twice.", source: "pull" },
    ],
  },
  {
    group: "Strong candidates that need a number attached",
    gist: "The figures a plant manager weighs. Each needs AFIMAC to pull or start measuring it.",
    items: [
      { fig: "__%", label: "Roles filled as requested", argues: "The most useful number on the page: “we sent who you asked for”.", from: "Deployment records — requested roles against roles supplied.", source: "pull" },
      { fig: "__%", label: "Crews on site by the agreed date", argues: "Makes the 72-hour claim checkable.", from: "Deployment records — committed date against arrival date.", source: "pull" },
      { fig: "__%", label: "Deployments completed without replacement", argues: "Retention — whether crews stay for the full assignment.", from: "Assignment records.", source: "pull" },
      { fig: "__%", label: "Clients who call again", argues: "Repeat business. Needs no explanation.", from: "Client records — repeat engagements over distinct clients.", source: "pull" },
      { fig: "0.00", label: "TRIR / recordable incident rate", argues: "Safety clears procurement in manufacturing.", from: "Safety records. <b>Publish only if it beats the industry average</b> — a mediocre TRIR argues against you.", source: "pull" },
    ],
  },
  {
    group: "Useful, but secondary",
    gist: "Useful on role pages and one-pagers. None belongs in a three-across band on the main pages.",
    items: [
      { fig: "##", label: "States &amp; provinces deployed into", argues: "Reach across North America, as a number.", from: "Deployment records.", source: "pull" },
      { fig: "###,###", label: "Shift hours worked", argues: "Scale, in the unit a plant schedules in.", from: "Timesheets. Large but abstract; it answers no question a buyer asked.", source: "pull" },
      { fig: "##", label: "Fortune 500 clients", argues: "Already claimed in prose on every page; a figure would make it checkable.", from: "Client records. <b>Confirm the claim is still true before putting a number on it.</b>", source: "pull" },
      { fig: "###", label: "Largest single deployment", argues: "The ceiling, for an unusually large job.", from: "Deployment records. Overlaps 1–500+, so run one or the other.", source: "pull" },
      { fig: "__ hrs", label: "Average first call to crew on floor", argues: "The average behind the 72-hour claim.", from: "<b>Needs measuring.</b> Only publish if the average is good; otherwise it undercuts the headline.", source: "new" },
    ],
  },
];

const rows = (items: Candidate[]): string =>
  items
    .map(
      (c) =>
        `<tr><th><span class="statmini">${c.fig}</span><span class="statminilab">${c.label}</span></th><td>${c.argues}</td><td>${c.from}</td><td class="hl"><span class="pip ${
          c.source === "have" ? "ok" : c.source === "pull" ? "gap" : "none"
        }">${SOURCE_LABEL[c.source]}</span></td></tr>`,
    )
    .join("");

const TOTAL = CANDIDATES.reduce((n, g) => n + g.items.length, 0);
const READY = CANDIDATES.reduce((n, g) => n + g.items.filter((c) => c.source === "have").length, 0);

const blocks: BlockType[] = [
  {
    cls: "dark",
    n: "THE STAT MODULE · WHAT ELSE BELONGS IN IT",
    h: `
  <h1>The stat band, and what else could go in it</h1>
  <p class="lead">The rest of the page describes what AFIMAC does. This band puts numbers to it — how much, how fast, how long.</p>
  <p class="lead">Below: the band as written, the three versions currently in use, and ${TOTAL} candidate figures graded by how easily AFIMAC could source each number.</p>`,
    spec: `Figures render from <code>INDUSTRY_COPY</code> and <code>LIVE_COUNTERS</code>, so the first two versions below come from the data rather than being retyped.`,
  },
  {
    cls: "blue",
    n: "AS WRITTEN · THE DECK VERSION",
    h: `
  <h2>${auto.numbersH2}</h2>
  <p class="lead">${auto.numbersBody}</p>
  ${band(auto.stats)}`,
    spec: `<b>Elementor:</b> Container · EK Funfact / Counter ×3, blue band. This is the module as the Automotive and Food &amp; Beverage decks write it.`,
  },
  {
    n: "THREE VERSIONS IN USE",
    h: `
  <h2>Three versions, and they disagree</h2>
  <div class="g3" style="margin-top:20px">
    <div><div class="catbar mfg">The deck · 3 figures</div>${band(auto.stats, true)}</div>
    <div><div class="catbar mfg">June-05 package · 4 figures</div>${band(JUNE05, true)}</div>
    <div><div class="catbar mfg">Live site · 4 counters</div><ul class="tick" style="margin-top:18px">${LIVE_COUNTERS.map(
      (c) => `<li>${c}</li>`,
    ).join("")}</ul><p class="modnote gap" style="margin-top:12px">No figures — they animate up from zero, so the numbers are not in the page text.</p></div>
  </div>
  <div class="note stop"><b>Only “40+ years” appears in all three.</b> The deck version drops the two figures carrying the speed and scale arguments. <b>One set has to win before any of this ships.</b> Adding figures to a band that disagrees with itself does not help. <a href="${u("/brand-check")}">All conflicts &rarr;</a></div>
  <div class="note"><b>The industries figure is settled: 26+.</b> It read 18+ until October, against a live counter saying 26. The client has called it for the counter. It also supports the line now in the nav panel: the menu shows eight industries and says those are not the limit. <b>26+ is the number behind that.</b></div>
  <div class="note stop"><b>But the overview still lists eighteen industries.</b> Claiming 26+ directly above a list of 18 is the same contradiction the section had before, with the numbers swapped. <b>Eight industries need adding to that list</b> before either figure goes out. <a href="${u("/overview")}">The list &rarr;</a></div>`,
  },
  {
    cls: "wash",
    n: "THE CANDIDATES",
    h: `
  <h2>${TOTAL} candidate figures</h2>
  <p class="lead">Graded by what it would take to put a number on them. <b>The figures shown are placeholders, not approved values.</b> Each needs AFIMAC to supply or confirm it.</p>
  ${CANDIDATES.map(
    (g) => `
  <h3 style="margin-top:30px">${g.group}</h3>
  <p>${g.gist}</p>
  <div class="tscroll" style="margin-top:14px"><table class="cmp"><thead><tr><th>Figure</th><th>What it argues</th><th>Where the number comes from</th><th class="hl">Can we source it?</th></tr></thead><tbody>${rows(
    g.items,
  )}</tbody></table></div>`,
  ).join("")}`,
    spec: `<b>${READY} need nothing:</b> they are approved figures from the June-05 package that this band dropped.`,
  },
  {
    n: "HOW TO USE THEM",
    h: `
  <h2>Four rules for the band</h2>
  <ol class="steps">
    <li><b>Every figure argues one thing, and no two argue the same thing.</b> 20,000+ skilled laborers and “laborers provided” sound like a pair but are different claims — network size against work done. Run both and one of them looks like padding.</li>
    <li><b>Three or four, never more.</b> Six figures across reads as a brochure. The rest can go on role pages, one-pagers and in the form follow-up.</li>
    <li><b>Put the number in the page text, not only in the counter.</b> The live counters animate from zero, so today the figures are invisible to search engines and to screen readers. Whatever wins should be written in the markup and animated on top, rather than produced by the animation.</li>
    <li><b>No figure ships without a source behind it.</b> Not on the page — in the brief. The industries count is the example: three numbers were live at once for months, and settling it took a decision rather than a lookup, because nobody could say where any of them came from.</li>
  </ol>
  <div class="note stop"><b>One phrasing still to settle.</b> This band now says <b>within 72 hours</b>. The deck copy says <b>“as little as 72 hours”</b> in six other places — both speed comparisons, both deployment headings and the shared timing data. <b>Those are different claims:</b> “within” is a commitment, “as little as” is a best case. Only the band is changed here. <b>Tell us and the other six follow</b>, but that is a claim decision rather than a copy fix.</div>
  <div class="note"><b>Where the rest go.</b> The ones that miss the band still have a place: fill rate and on-time arrival belong beside the form, where a buyer is deciding whether to send the enquiry; safety belongs on role pages; states and provinces belongs on the overview, next to the map.</div>`,
  },
  {
    cls: "blue",
    n: "RECOMMENDATION",
    h: `
  <h2>Our recommendation</h2>
  <p class="lead"><b>40+ years · 20,000+ skilled laborers · within 72 hours to a crew on site · __% roles filled as requested.</b></p>
  <p>The first three are already approved, so three quarters of this needs no decision. The fourth needs work. It is also the one a plant manager weighs most: <b>“we sent who you asked for”</b> is what the service promises, and fill rate is the only figure here that evidences it.</p>
  <div class="note"><b>If the fill rate cannot be produced, run 1–500+ scalable crew size instead</b> and the band is entirely pre-approved figures. That version could ship this week.</div>
  <div class="note stop"><b>We cannot decide this.</b> Every number belongs to AFIMAC. The grading says what it would take to find each one, not what any of them are.</div>`,
  },
];
---

<Prototype
  title="The stat module"
  crumb="The stat module"
  url="Internal — not a site page"
  status="build"
>
  {blocks.map((b) => <Block {...b} />)}
</Prototype>
