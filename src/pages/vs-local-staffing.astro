  ["A deadline, launch, or backlog at risk right now", "AFIMAC CSTL", true],
  ["Local market is tight or tapped out", "AFIMAC CSTL", true],
  ["You need a capable team in days", "AFIMAC CSTL", true],
  ["The need is temporary and will demobilize", "AFIMAC CSTL", true],
  ["A workforce disruption looms", "AFIMAC CSTL", true],
];

const FAQ: [string, string][] = [
  ["What’s the difference between CSTL and a local staffing agency?", "A local agency sources candidates from the local market and hands them to you to manage. CSTL sources from a national network, travels and houses the crew, handles safety onboarding, and supervises the work on site. You end up with a working crew, not a pile of resumes to sort through."],
  ["Is travel labor more expensive than hiring locally?", "The day rate can be higher, but the right comparison is total cost. When an open gap lets a deadline slip, penalties, lost orders, and overtime usually cost more than travel labor would have. AFIMAC scopes the full cost against the risk avoided during the consultation."],
  ["When should I use travel labor instead of local hiring?", "When the local market can’t supply the skills fast enough, the gap is large or time-critical, and you need a crew productive in days rather than weeks."],
  ["Contract or permanent: which is right for a temporary gap?", "For a gap with a clear beginning and end (a launch, backlog, or changeover), contract labor is the cleaner fit. You employ a team while you need it and demobilize when your permanent workforce recovers, with no long-term cost left on the books."],
  ["How fast can CSTL move compared to the alternatives?", "Direct hire typically runs 45–90 days to a productive crew and an agency 14–35 days. For most roles, AFIMAC can provide a CSTL team within days of a signed plan."],
  ["Do I still have to manage the workers?", "No. AFIMAC provides on-site supervision and a single point of contact, working alongside your team, so your managers aren’t absorbing the workers on top of their typical duties."],
];

const RAIL = [
  "3 Common Missteps to Avoid When Hiring Travel Labor",
  "When AFIMAC is the Right Fit",
  "Ready on Day 1: The Case for Travel Labor at Your Next Line Launch",
];

const row3 = (rows: [string, string, string][], a: string, b: string) =>
  `<div class="tscroll"><table class="cmp"><thead><tr><th></th><th>${a}</th><th class="hl">${b}</th></tr></thead><tbody>${rows
    .map(([k, l, r]) => `<tr><th>${k}</th><td>${l}</td><td class="hl">${r}</td></tr>`)
    .join("")}</tbody></table></div>`;

const RAIL_CARDS = RAIL.map((t) => {
  const art = postArt(t);
  const live = postTitleDrift(t);
  return `<div class="card">${art ? liveImg(art) : photo("1280×720 (16:9) · post featured image")}<h3 style="margin-top:16px">${t}</h3>${
    art ? "" : `<p style="font-size:12.5px;color:var(--spec)">No live post found under this title</p>`
  }${live ? `<p style="font-size:12.5px;color:var(--stop)">Published as “${live}”</p>` : ""}<a class="readmore" href="${u("/overview")}">Read More »</a></div>`;
}).join("");

