---
/**
 * WHO WE DEPLOY — the section landing page.
 *
 * This was an internal index of the family pages. It is now the page a
 * visitor lands on from the nav entry, with the build material it used to
 * carry kept as notes and specs rather than as the page itself.
 *
 * The family cards are read from ROLE_FAMILIES, so the landing page, the
 * dropdown and the family pages cannot disagree about what AFIMAC deploys.
 *
 * NO COUNT IS PRINTED ANYWHERE ON THIS PAGE, deliberately. A figure in front
 * of "families" or "job titles" reads as the extent of what AFIMAC fills. The
 * families are the trades it is asked for most; it recruits to the role from a
 * 20,000+ network. Every block that could name a number links to Other Roles
 * instead.
 */
import Prototype from "../layouts/Prototype.astro";
import Block from "../components/Block.astro";
import { u } from "../lib/base";
import { B } from "../data/nav";
import { photo } from "../lib/wireframe";
import { roleHero, leadFormBlock, insightsBlock, faqBlock, COST_ANSWER, SUPERVISION_ANSWER } from "../lib/role-blocks";
import { INCLUDED } from "../lib/family-page";
import { ROLE_FAMILIES, INDUSTRY_ROLE_SAMPLES, INDUSTRIES_AWAITING_ROLES } from "../data/nav-options";
import { DECKS_AWAITING_SPLIT } from "../data/industry-roles";
import type { Block as BlockType } from "../lib/types";

/** One line per family, saying what those skills are for rather than what the page does. */
const GIST: Record<string, string> = {
  "Machining &amp; Precision Manufacturing": "Operators, machinists and programmers for the seats that take years to fill locally.",
  "Welding &amp; Fabrication": "Certified welders, the fit-up before the arc, and the robotic cells.",
  "Production &amp; Assembly": "A few stations or a whole shift, to your work instructions and your line rate.",
  "Material Handling &amp; Warehouse Operations": "Certified truck operators, pickers and handlers for the dock and the racking.",
  "Packaging Operations": "Fill to pallet, staffed end to end against the date the window closes.",
  "Sanitation &amp; Facility Support": "The reset between production days, run to your documented program.",
};

const cards = ROLE_FAMILIES.map(
  (f) => `<a class="card famcard" href="${u(f.pages[0].route)}">
     <h3>${f.label}</h3>
     <p class="famgist">${GIST[f.label] ?? ""}</p>
     <p class="famroles">${f.roles.join(" · ")}</p>
     <span class="readmore">See the skills &raquo;</span></a>`,
).join("");

const PHASES: [string, string, string][] = [
  ["PHASE 1 · ASSESSMENT", "Assessment", "We map the seats, the shift plan and the site requirements, and scope the timeline and the cost."],
  ["PHASE 2 · MOBILIZATION", "Mobilization", "We source and screen from a 20,000+ talent network, run credential and role checks, and book travel and housing."],
  ["PHASE 3 · DEPLOYMENT", "Deployment", "Your people work the floor under AFIMAC supervision, with a single point of contact and daily reporting."],
  ["PHASE 4 · DEMOBILIZATION", "Demobilization", "A final review, a planned handoff, and they stand down when your own workforce recovers."],
];

/** Old path to new. Built as a list so a slug change cannot leave it behind. */
const REDIRECTS: [string, string][] = [
  ["/roles/", "/who-we-deploy/"],
  ["/roles/cnc-operators/", "/who-we-deploy/machining-precision-manufacturing/"],
  ["/roles/welders/", "/who-we-deploy/welding-fabrication/"],
  ["/roles/assemblers-production/", "/who-we-deploy/production-assembly/"],
  ["/roles/forklift-operators/", "/who-we-deploy/material-handling-warehouse-operations/"],
  ["/roles/packaging-operations/", "/who-we-deploy/packaging-operations/"],
  ["/roles/sanitation-crews/", "/who-we-deploy/sanitation-facility-support/"],
  ["/roles/machinists/", "/who-we-deploy/machinists/"],
];

/** Hoisted out of the FAQ array: a nested backtick inside an array literal
    inside the frontmatter is valid TypeScript and not valid Astro. */
const WHICH_ROLES =
  "The skills on this page are the ones AFIMAC is asked for most, drawn from a network of " +
  "20,000+ skilled and unskilled workers. AFIMAC recruits to the role, so plenty of " +
  "what it deploys sits outside them. " +
  '<a href="' + u("/who-we-deploy/other-roles") + '">Tell us the role you need</a> and we will tell you how long it takes to get people there.';

const blocks: BlockType[] = [
  roleHero({
    h1: "Who We Deploy",
    sub: "Skilled People, Screened and Travel-Ready, On Your Floor in Days",
    body: `AFIMAC deploys skilled and production labor to manufacturing plants, warehouses and distribution centers across North America, recruited to the role from a network of 20,000+ vetted, mobile workers. One machinist or over a hundred production workers, for as long as the gap lasts. Travel, housing, screening and on-site supervision are ours.`,
    cta2: "See the skills",
    cta2Href: "#families",
    img: "Full-bleed hero · 2560×1440 JPG (min 2000px wide) · a mixed crew walking a plant floor at shift change, badges visible, plant depth behind · muted industrial tone under the navy scrim · mobile crop 1080×1350",
    spec: `<b>Elementor:</b> the same hero saved section the six family pages use, with the section's own copy. <b>This page is new</b> — it did not exist in the IA deck, which took the nav entry straight to the role pages.`,
  }),

  {
    n: "BLOCK 02 · WHAT TRAVEL LABOR IS",
    h: `
  <h2>Not a temp agency, and not a local hire</h2>
  <div class="g2" style="margin-top:24px">
   <div>
    <p>Travel labor is skilled people AFIMAC recruits nationally, screens, credentials, moves to your site, houses and supervises, then stands down when you no longer need them. A single specialist or a whole shift; the number is whatever the gap is. It exists for the gap a local hiring cycle cannot close in time: a launch, a turnaround, a relocation, a strike, a season, a shift that turnover has thinned past the point of running.</p>
    <p>That is a different proposition from a staffing agency filling requisitions one at a time. Everyone arrives to a plan agreed before anyone travels, and they are managed on your floor by AFIMAC rather than handed to your supervisors to absorb.</p>
   </div>
   ${photo("1200×1500 JPG (4:5) beside the intro · a crew arriving at a plant entrance with gear, early light · muted tone · no staged poses")}
  </div>
  <div class="note"><b>This block is new copy.</b> The cluster explains travel labor on <a href="${u("/what-is-travel-labor")}">What Is Travel Labor</a> and <a href="${u("/vs-local-staffing")}">Travel vs. Local Staffing</a>; this is the two-paragraph version for people who arrive at the section from the nav rather than from the pillar. <b>Check it against the approved pillar copy before build</b> so the three do not drift.</div>`,
    spec: `<b>Elementor:</b> Heading · Text Editor · Image. Link both mentions to the pillar pages rather than restating them here.`,
  },

  {
    cls: "wash",
    id: "families",
    n: "BLOCK 03 · THE SKILLS",
    h: `
  <h2>The skills AFIMAC is asked for most</h2>
  <p class="lead">These families group the skills and are how this section is navigated. The job titles under each are what that group commonly covers. AFIMAC recruits to the role, so a seat that is not listed here is still a seat it can fill.</p>
  <div class="g3 famgrid">${cards}</div>
  <p style="margin-top:28px">AFIMAC deploys one person or over a hundred at a time, in any mix of these skills. Need a role that is not here? <a href="${u("/who-we-deploy/other-roles")}">Tell us what you are short of</a> and we will tell you how long it takes to get people there.</p>
  <div class="note"><b>The cards, the dropdown and the role grids on the family pages all read from one list.</b> A family cannot gain a job title here and keep the old set in the menu. <b>The heading used to count the families and the job titles</b> — both counts are gone, because a figure in front of them reads as the limit of what AFIMAC fills.</div>`,
    spec: `<b>Elementor:</b> Container (3-col) · EK Image Box ×6, linked to the six family pages. <b>Asset gap:</b> six family icons or photographs, not yet commissioned — the role-page icon set should cover them.`,
  },

  {
    n: "BLOCK 04 · ACROSS THE INDUSTRIES",
    h: `
  <h2>What we staff depends on the plant</h2>
  <p class="lead">The skills above are the ones AFIMAC is asked for most, drawn from a network of 20,000+ skilled and unskilled workers. What a floor is short of changes with the work it runs. Here is some of what AFIMAC staffs in the industries it works in.</p>
  <div class="tscroll" style="margin-top:22px"><table class="cmp"><thead><tr><th>Industry</th><th class="hl">Some of what we staff there</th></tr></thead><tbody>
   ${INDUSTRY_ROLE_SAMPLES.map((i) => `<tr><th><a href="${u(i.route)}">${i.label}</a></th><td class="hl">${i.roles.length ? i.roles.join(" · ") : `<span class="pip gap">role set not written</span>`}</td></tr>`).join("")}
  </tbody></table></div>
  <p style="margin-top:22px">Don&rsquo;t see the role you need? If it runs on your floor, we can staff it.</p>
  <p style="margin-top:22px"><a class="btn" href="${u("/who-we-deploy/other-roles")}">Tell us the role you need &raquo;</a></p>
  <div class="note"><b>Every industry page is here, and this block reads from them.</b> It used to show the <b>15 generic roles the live site repeats word for word on every industry page</b>, in three groups — Manufacturing, Warehousing, Logistics — not one of them specific to any industry. The roles shown are one per station from the industry's own copy: the built pages read from their page copy, and Chemicals &amp; Plastics, Consumer Goods and Oil &amp; Energy read from <b>section 04 of their copy decks</b>, so the table carries approved-track roles before those pages are built. <b>${INDUSTRIES_AWAITING_ROLES} of the ${INDUSTRY_ROLE_SAMPLES.length} still have no role set anywhere</b> — Aerospace, Aviation &amp; Defense and Industrial Equipment have no deck. Those rows are marked rather than filled with a borrowed list, because a row carrying another industry's roles would be worse than an empty one. <b>"Don't see the role you need? If it runs on your floor, we can staff it." is AFIMAC's own line</b> — every deck closes its role grid with a version of it.</div>
  <div class="note stop"><b>Two page splits are open and this table assumes neither.</b> ${DECKS_AWAITING_SPLIT.length} decks are written for pages that do not exist: ${DECKS_AWAITING_SPLIT.map((d) => `<i>${d.split(" \u2014 ")[0]}</i>`).join(" and ")}. Per Maria 10/23, <b>Chemicals &amp; Plastics may split into Chemicals and Plastics</b>, and <b>Oil &amp; Energy into Oil &amp; Gas and Power &amp; Energy</b>. The rows above use the combined decks, which match the live URLs. <b>Adding the split pages now would count plastics and power twice</b>, and the Oil &amp; Gas half has no deck at all. Their role grids are held in <code>industry-roles.ts</code> and drop straight in once the structure is decided.</div>`,
    spec: `<b>Elementor:</b> Heading · Text Editor · Table · Button. <b>Rows are read from the nav and the industry copy</b>, so an industry gaining its own roles fills its own row here with no second list to maintain. <b>Do not hand-type the table</b> — it goes stale the moment an industry page changes.`,
  },

  {
    cls: "blue",
    n: "BLOCK 05 · HOW A DEPLOYMENT RUNS",
    h: `
  <h2>Four phases, whoever is deployed</h2>
  <p class="lead">The same engagement runs behind every family. What changes between them is the seats, not the process.</p>
  <div class="g4" style="margin-top:28px">
   ${PHASES.map(([label, name, body]) => `<div class="card"><div class="blocknum">${label}</div><h3>${name}</h3><p style="margin:0">${body}</p></div>`).join("")}
  </div>
  <h3 style="margin-top:34px">What is included, whoever is deployed</h3>
  <div class="g2" style="margin-top:16px">
   <ul class="tick">${INCLUDED.slice(0, 4).map((i) => `<li>${i}</li>`).join("")}</ul>
   <ul class="tick">${INCLUDED.slice(4).map((i) => `<li>${i}</li>`).join("")}</ul>
  </div>
  <div class="note">Phase names and durations follow the approved process doc, including its open <b>Assessment vs. Consultation</b> naming flag. <a href="${u("/brand-check")}">All conflicts →</a></div>`,
    spec: `<b>Elementor:</b> Container (4-col) · EK Icon Box ×4 · EK Icon List ×2, Readiness Blue band. <b>The seven included items are the same global widget</b> the six family pages and <a href="${u("/how-it-works")}">How It Works</a> use.`,
  },

  {
    n: "BLOCK 06 · PROOF IT WORKS",
    h: `
  <h2>Deployments that kept Fortune 500 operations running</h2>
  <div class="casecard">
   ${photo("1600×1000 JPG (8:5) on the featured card · a full production floor mid-shift, crew at stations, a working shot")}
   <div class="body">
    <div class="blocknum">FEATURED CASE</div>
    <p>A Fortune 500 manufacturer faced mounting production delays, with past-due orders peaking at $5.76 million. AFIMAC deployed skilled labor, including assemblers, CNC machinists, and welders. Past-due sales fell by 73.4% and performance returned to previously high levels.</p>
   </div>
  </div>
  <div class="card" style="margin-top:26px">
   <div class="blocknum">SUPPORTING CASE</div>
   <p style="margin:0">When a Fortune 500 food manufacturer needed its production facility fully staffed on short notice, AFIMAC deployed 99 personnel across the operation and kept it running until the client's workforce recovered.</p>
  </div>
  <div class="note">Both cases are published on the live CSTL pillar and are the same two the family pages lead with. <b>Link them to the pillar rather than building standalone case pages.</b></div>`,
    spec: `<b>Elementor:</b> Container (2-col) · Image · Heading · Text Editor. Same three published cases carry the whole cluster.`,
  },

  faqBlock({
    n: "BLOCK 07 · FAQ",
    h2: "Questions buyers ask first",
    items: [
      ["Which roles can you actually deploy?", WHICH_ROLES],
      ["How many people can you send?", "Anywhere from one to over a hundred. Published AFIMAC deployments run from a 12-person specialist team to a 99-person production deployment, and the headcount can move up or down while the engagement runs."],
      ["How fast can people be on site?", "Within days of a signed plan for most roles. Exact timing depends on the roles, the headcount, the location and the compliance requirements."],
      ["Who supervises them?", SUPERVISION_ANSWER],
      ["How long can they stay?", "As long as the gap lasts. Engagements are temporary by design and end with a planned demobilization when your permanent workforce recovers."],
      ["What does it cost?", COST_ANSWER],
    ],
    spec: `<b>Elementor:</b> EK Accordion (6 items) + FAQPage structured data. Four are the cluster's shared answers — <b>keep the wording identical</b> to the <a href="${u("/faq")}">FAQ page</a> and the family pages. <b>"How many people can you send?" is new and not in the cluster FAQ</b>; both figures in it are published AFIMAC deployments. Do not add it to the schema until approved.`,
  }),

  insightsBlock({
    n: "BLOCK 08 · RELATED INSIGHTS",
    titles: [
      "The Labor Gap Took Decades to Build. Closing It Requires a New Playbook.",
      "Ready on Day One",
      "When AFIMAC is the Right Fit",
    ],
    spec: `<b>Elementor:</b> EK Post Grid (3-up). Section-level posts rather than the family-specific combinations the six pages run.`,
  }),

  leadFormBlock({
    n: "BLOCK 09 · TALK TO AFIMAC (LEAD FORM)",
    h2: "Short-staffed? Let's scope it.",
    bullets: [
      "The roles, and how many people we'd send",
      "A realistic timeline to people on your floor",
      "A ballpark cost",
    ],
    illo: "1200×1200 flat isometric vector beside the form · a mixed-crew motif, machining and material handling together · greys with safety-orange and blue",
    spec: `<b>Elementor:</b> Metform · EK Icon List · Button, Mobilization Sky band. The same global form section as the six family pages.`,
  }),

  {
    cls: "wash",
    n: "INTERNAL · THE URLS, AND THE REDIRECTS THEY NEED",
    h: `
  <div class="note" style="margin-top:0"><b>The URLs follow the section and the page title.</b> <code>/roles/</code> was the drafted pattern and never matched what the nav says; every page in the cluster now sits under <code>/who-we-deploy/</code> with a slug that is its family.</div>
  <div class="tscroll" style="margin-top:20px"><table class="cmp"><thead><tr><th>Was</th><th>Is</th><th class="hl">Needs</th></tr></thead><tbody>${REDIRECTS.map(
    ([was, now]) => `<tr><th><code>${was}</code></th><td><code>${now}</code></td><td class="hl">301</td></tr>`,
  ).join("")}</tbody></table></div>
  <div class="note stop"><b>${REDIRECTS.length} redirects, and none of these pages is live yet.</b> The old paths exist only in this prototype and in the copy decks, so nothing is 404ing in public today — but <b>the decks, the build sheet and any link already shared carry the old paths</b>, and the redirects have to go in with the build rather than after it.</div>
  <div class="note"><b>Two pages still have no nav slot.</b> <code>/who-we-deploy/machinists</code> is written and wireframed and sits behind Machining &amp; Precision Manufacturing; Warehouse &amp; Logistics has no copy and no page and sits behind Material Handling. <b>Both are merges the family list implies and neither has been made.</b></div>`,
    spec: `<b>Elementor / hosting:</b> eight 301s. <b>This block is prototype chrome</b> — it is here so the redirect list travels with the section, and it comes off before the page ships.`,
  },
];
---

<Prototype
  title="Who We Deploy"
  crumb="Solutions › CSTL › Who We Deploy"
  url={`${B}who-we-deploy/`}
  status="build"
  active="/who-we-deploy"
  meta={{
    t: "Who We Deploy: Skilled Travel Labor Staffing | AFIMAC Global",
    d: "AFIMAC deploys machining, welding, production, material handling, packaging and sanitation workers in days — one person or over a hundred, housing handled.",
    k: "travel labor crews · skilled labor staffing — secondary: travel welders · travel machinists · warehouse staffing · production staffing · sanitation staffing",
  }}
>
  {blocks.map((b) => <Block {...b} />)}
</Prototype>
