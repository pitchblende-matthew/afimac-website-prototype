---
/**
 * WHO WE DEPLOY — the section landing page.
 *
 * This was an internal index of the family pages. It is now the page a
 * visitor lands on from the nav entry, with the build material it used to
 * carry kept as notes and specs rather than as the page itself.
 *
 * The six family cards and every count on the page are read from
 * ROLE_FAMILIES, so the landing page, the dropdown and the family pages
 * cannot disagree about what AFIMAC deploys.
 */
import Prototype from "../layouts/Prototype.astro";
import Block from "../components/Block.astro";
import { u } from "../lib/base";
import { B } from "../data/nav";
import { photo } from "../lib/wireframe";
import { roleHero, leadFormBlock, insightsBlock, faqBlock, COST_ANSWER, SUPERVISION_ANSWER } from "../lib/role-blocks";
import { INCLUDED } from "../lib/family-page";
import { ROLE_FAMILIES, FAMILY_STATS, UNCOVERED_LIVE_ROLES, UNCOVERED_ROLE_COUNT, numWord, NumWord } from "../data/nav-options";
import type { Block as BlockType } from "../lib/types";

/** One line per family, saying what that crew is for rather than what the page does. */
const GIST: Record<string, string> = {
  "Machining &amp; Precision Manufacturing": "Operators, machinists and programmers for the seats that take years to fill locally.",
  "Welding &amp; Fabrication": "Certified welders, the fit-up before the arc, and the robotic cells.",
  "Production &amp; Assembly": "A few stations or a whole shift, to your work instructions and your line rate.",
  "Material Handling &amp; Warehouse Operations": "Certified truck operators, pickers and handlers for the dock and the racking.",
  "Packaging Operations": "Fill to pallet, staffed end to end against the date the window closes.",
  "Sanitation &amp; Facility Support": "The reset between production days, run to your documented program.",
};

const cards = ROLE_FAMILIES.map(
  (f) => `<a class="card famcard" href="${u(f.pages[0].route)}">
     <h3>${f.label}</h3>
     <p class="famgist">${GIST[f.label] ?? ""}</p>
     <p class="famroles">${f.roles.join(" · ")}</p>
     <span class="readmore">See the crew &raquo;</span></a>`,
).join("");

const PHASES: [string, string, string][] = [
  ["PHASE 1 · ASSESSMENT", "Assessment", "We map the seats, the shift plan and the site requirements, and scope the timeline and the cost."],
  ["PHASE 2 · MOBILIZATION", "Mobilization", "We source and screen from a 20,000+ talent network, run credential and role checks, and book travel and housing."],
  ["PHASE 3 · DEPLOYMENT", "Deployment", "The crew works your floor under AFIMAC supervision, with a single point of contact and daily reporting."],
  ["PHASE 4 · DEMOBILIZATION", "Demobilization", "A final review, a planned handoff, and the crew stands down when your own workforce recovers."],
];

/** Old path to new. Built as a list so a slug change cannot leave it behind. */
const REDIRECTS: [string, string][] = [
  ["/roles/", "/who-we-deploy/"],
  ["/roles/cnc-operators/", "/who-we-deploy/machining-precision-manufacturing/"],
  ["/roles/welders/", "/who-we-deploy/welding-fabrication/"],
  ["/roles/assemblers-production/", "/who-we-deploy/production-assembly/"],
  ["/roles/forklift-operators/", "/who-we-deploy/material-handling-warehouse-operations/"],
  ["/roles/packaging-operations/", "/who-we-deploy/packaging-operations/"],
  ["/roles/sanitation-crews/", "/who-we-deploy/sanitation-facility-support/"],
  ["/roles/machinists/", "/who-we-deploy/machinists/"],
];

const blocks: BlockType[] = [
  roleHero({
    h1: "Who We Deploy",
    sub: "Skilled Crews, Screened and Travel-Ready, On Your Floor in Days",
    body: `AFIMAC deploys ${numWord(FAMILY_STATS.families)} families of skilled and production labor to manufacturing plants, warehouses and distribution centers across North America. Travel, housing, screening and on-site supervision are ours. The crew is yours for as long as the gap lasts.`,
    cta2: "See the six families",
    cta2Href: "#families",
    img: "Full-bleed hero · 2560×1440 JPG (min 2000px wide) · a mixed crew walking a plant floor at shift change, badges visible, plant depth behind · muted industrial tone under the navy scrim · mobile crop 1080×1350",
    spec: `<b>Elementor:</b> the same hero saved section the six family pages use, with the section's own copy. <b>This page is new</b> — it did not exist in the IA deck, which took the nav entry straight to the role pages.`,
  }),

  {
    n: "BLOCK 02 · WHAT A TRAVEL CREW IS",
    h: `
  <h2>Not a temp agency, and not a local hire</h2>
  <div class="g2" style="margin-top:24px">
   <div>
    <p>A travel labor crew is a screened, credentialed team that AFIMAC recruits nationally, moves to your site, houses, supervises and stands down when you no longer need it. It exists for the gap a local hiring cycle cannot close in time — a launch, a turnaround, a relocation, a strike, a season, a shift that turnover has thinned past the point of running.</p>
    <p>That is a different proposition from a staffing agency filling requisitions one at a time. The crew arrives as a crew, to a plan agreed before anyone travels, and it is managed on your floor by AFIMAC rather than handed to your supervisors to absorb.</p>
   </div>
   ${photo("1200×1500 JPG (4:5) beside the intro · a crew arriving at a plant entrance with gear, early light · muted tone · no staged poses")}
  </div>
  <div class="note"><b>This block is new copy.</b> The cluster explains travel labor on <a href="${u("/what-is-travel-labor")}">What Is Travel Labor</a> and <a href="${u("/vs-local-staffing")}">Travel vs. Local Staffing</a>; this is the two-paragraph version for people who arrive at the section from the nav rather than from the pillar. <b>Check it against the approved pillar copy before build</b> so the three do not drift.</div>`,
    spec: `<b>Elementor:</b> Heading · Text Editor · Image. Link both mentions to the pillar pages rather than restating them here.`,
  },

  {
    cls: "wash",
    id: "families",
    n: "BLOCK 03 · THE SIX FAMILIES",
    h: `
  <h2>${NumWord(FAMILY_STATS.families)} families, ${FAMILY_STATS.titles} job titles</h2>
  <p class="lead">The families are how the crews are organised and how this section is navigated. The job titles under each are what a family actually covers — not every seat AFIMAC fills, but the ones asked for most.</p>
  <div class="g3 famgrid">${cards}</div>
  <div class="note"><b>The cards, the dropdown and the role grids on the six pages all read from one list.</b> A family cannot gain a job title here and keep the old set in the menu.</div>`,
    spec: `<b>Elementor:</b> Container (3-col) · EK Image Box ×6, linked to the six family pages. <b>Asset gap:</b> six family icons or photographs, not yet commissioned — the role-page icon set should cover them.`,
  },

  {
    n: "BLOCK 04 · BEYOND THE SIX",
    h: `
  <h2>The six are the common asks, not the limit</h2>
  <p class="lead">AFIMAC's published role list runs wider than the families. ${NumWord(UNCOVERED_ROLE_COUNT)} of the roles named on the live site sit outside the six — instrumentation, heavy equipment, inventory control and the logistics seats among them.</p>
  <div class="tscroll" style="margin-top:22px"><table class="cmp"><thead><tr><th>Group</th><th class="hl">Roles outside the six families</th></tr></thead><tbody>
   ${UNCOVERED_LIVE_ROLES.map(([g, rs]) => `<tr><th>${g}</th><td class="hl">${rs.join(" · ")}</td></tr>`).join("")}
  </tbody></table></div>
  <p style="margin-top:22px"><a class="btn" href="${u("/who-we-deploy/other-roles")}">Tell us the seat you need &raquo;</a></p>
  <div class="note"><b>Every role in that table is already published on afimacglobal.com</b> — this page is not widening the claim, it is pointing at the part of the published list the six families do not reach. <a href="${u("/who-we-deploy/other-roles")}">The page behind the button</a> carries the full list and the form.</div>`,
    spec: `<b>Elementor:</b> Heading · Text Editor · Table or EK Icon List · Button. <b>Read from the live site's role groups</b>, so if AFIMAC publishes a new role this table picks it up rather than going stale.`,
  },

  {
    cls: "blue",
    n: "BLOCK 05 · HOW A DEPLOYMENT RUNS",
    h: `
  <h2>Four phases, whoever is deployed</h2>
  <p class="lead">The same engagement runs behind every family. What changes between them is the seats, not the process.</p>
  <div class="g4" style="margin-top:28px">
   ${PHASES.map(([label, name, body]) => `<div class="card"><div class="blocknum">${label}</div><h3>${name}</h3><p style="margin:0">${body}</p></div>`).join("")}
  </div>
  <h3 style="margin-top:34px">What is included, whoever is deployed</h3>
  <div class="g2" style="margin-top:16px">
   <ul class="tick">${INCLUDED.slice(0, 4).map((i) => `<li>${i}</li>`).join("")}</ul>
   <ul class="tick">${INCLUDED.slice(4).map((i) => `<li>${i}</li>`).join("")}</ul>
  </div>
  <div class="note">Phase names and durations follow the approved process doc, including its open <b>Assessment vs. Consultation</b> naming flag. <a href="${u("/brand-check")}">All conflicts →</a></div>`,
    spec: `<b>Elementor:</b> Container (4-col) · EK Icon Box ×4 · EK Icon List ×2, Readiness Blue band. <b>The seven included items are the same global widget</b> the six family pages and <a href="${u("/how-it-works")}">How It Works</a> use.`,
  },

  {
    n: "BLOCK 06 · PROOF IT WORKS",
    h: `
  <h2>Crews that kept Fortune 500 operations running</h2>
  <div class="casecard">
   ${photo("1600×1000 JPG (8:5) on the featured card · a full production floor mid-shift, crew at stations, a working shot")}
   <div class="body">
    <div class="blocknum">FEATURED CASE</div>
    <p>A Fortune 500 manufacturer faced mounting production delays, with past-due orders peaking at $5.76 million. AFIMAC deployed skilled labor, including assemblers, CNC machinists, and welders. Past-due sales fell by 73.4% and performance returned to previously high levels.</p>
   </div>
  </div>
  <div class="card" style="margin-top:26px">
   <div class="blocknum">SUPPORTING CASE</div>
   <p style="margin:0">When a Fortune 500 food manufacturer needed its production facility fully staffed on short notice, AFIMAC deployed 99 personnel across the operation and kept it running until the client's workforce recovered.</p>
  </div>
  <div class="note">Both cases are published on the live CSTL pillar and are the same two the family pages lead with. <b>Link them to the pillar rather than building standalone case pages.</b></div>`,
    spec: `<b>Elementor:</b> Container (2-col) · Image · Heading · Text Editor. Same three published cases carry the whole cluster.`,
  },

  faqBlock({
    n: "BLOCK 07 · FAQ",
    h2: "Questions buyers ask first",
    items: [
      ["Which roles can you actually deploy?", `The six families on this page cover the seats asked for most. AFIMAC's published role list runs wider — ${numWord(UNCOVERED_ROLE_COUNT)} further roles across manufacturing, warehousing and logistics. If the seat you need is not named, it is still worth asking.`],
      ["How fast can a crew be on site?", "Within days of a signed plan for most roles. Exact timing depends on the roles, the headcount, the location and the compliance requirements."],
      ["Who supervises the crew?", SUPERVISION_ANSWER],
      ["How long can a crew stay?", "As long as the gap lasts. Engagements are temporary by design and end with a planned demobilization when your permanent workforce recovers."],
      ["What does it cost?", COST_ANSWER],
    ],
    spec: `<b>Elementor:</b> EK Accordion (5 items) + FAQPage structured data. Four of the five are the cluster's shared answers — <b>keep the wording identical</b> to the <a href="${u("/faq")}">FAQ page</a> and the family pages.`,
  }),

  insightsBlock({
    n: "BLOCK 08 · RELATED INSIGHTS",
    titles: [
      "The Labor Gap Took Decades to Build. Closing It Requires a New Playbook.",
      "Ready on Day One",
      "When AFIMAC is the Right Fit",
    ],
    spec: `<b>Elementor:</b> EK Post Grid (3-up). Section-level posts rather than the family-specific combinations the six pages run.`,
  }),

  leadFormBlock({
    n: "BLOCK 09 · TALK TO AFIMAC (LEAD FORM)",
    h2: "Short a crew? Let's scope it.",
    bullets: [
      "The roles and crew size we'd send",
      "A realistic timeline to people on your floor",
      "A ballpark cost",
    ],
    illo: "1200×1200 flat isometric vector beside the form · a mixed-crew motif, machining and material handling together · greys with safety-orange and blue",
    spec: `<b>Elementor:</b> Metform · EK Icon List · Button, Mobilization Sky band. The same global form section as the six family pages.`,
  }),

  {
    cls: "wash",
    n: "INTERNAL · THE URLS, AND THE REDIRECTS THEY NEED",
    h: `
  <div class="note" style="margin-top:0"><b>The URLs follow the section and the page title.</b> <code>/roles/</code> was the drafted pattern and never matched what the nav says; every page in the cluster now sits under <code>/who-we-deploy/</code> with a slug that is its family.</div>
  <div class="tscroll" style="margin-top:20px"><table class="cmp"><thead><tr><th>Was</th><th>Is</th><th class="hl">Needs</th></tr></thead><tbody>${REDIRECTS.map(
    ([was, now]) => `<tr><th><code>${was}</code></th><td><code>${now}</code></td><td class="hl">301</td></tr>`,
  ).join("")}</tbody></table></div>
  <div class="note stop"><b>${REDIRECTS.length} redirects, and none of these pages is live yet.</b> The old paths exist only in this prototype and in the copy decks, so nothing is 404ing in public today — but <b>the decks, the build sheet and any link already shared carry the old paths</b>, and the redirects have to go in with the build rather than after it.</div>
  <div class="note"><b>Two pages still have no nav slot.</b> <code>/who-we-deploy/machinists</code> is written and wireframed and sits behind Machining &amp; Precision Manufacturing; Warehouse &amp; Logistics has no copy and no page and sits behind Material Handling. <b>Both are merges the family list implies and neither has been made.</b></div>`,
    spec: `<b>Elementor / hosting:</b> eight 301s. <b>This block is prototype chrome</b> — it is here so the redirect list travels with the section, and it comes off before the page ships.`,
  },
];
---

<Prototype
  title="Who We Deploy"
  crumb="Solutions › CSTL › Who We Deploy"
  url={`${B}who-we-deploy/`}
  status="build"
  active="/who-we-deploy"
  meta={{
    t: "Who We Deploy: Skilled Travel Labor Crews | AFIMAC Global",
    d: "AFIMAC deploys machining, welding, production, material handling, packaging and sanitation crews to your plant in days, with travel, housing and supervision handled.",
    k: "travel labor crews · skilled labor staffing — secondary: travel welders · travel machinists · warehouse staffing · production staffing · sanitation staffing",
  }}
>
  {blocks.map((b) => <Block {...b} />)}
</Prototype>
