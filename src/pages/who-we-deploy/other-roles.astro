---
/**
 * OTHER ROLES WE DEPLOY — the page behind the nav's "Looking for something
 * else?" entry.
 *
 * A form page. The six families in the menu are the crews AFIMAC is asked for
 * most; it staffs plenty of roles outside them. The page exists to say so and
 * take the enquiry.
 *
 * What it must NOT do is present a role list as a boundary. AFIMAC does not
 * publish a closed list of roles; what varies is how long a given seat takes
 * to source, which is what the timeline block is for. The roles shown here are
 * examples from the live industry pages, labeled as examples.
 */
import Prototype from "../../layouts/Prototype.astro";
import Block from "../../components/Block.astro";
import { u } from "../../lib/base";
import { B } from "../../data/nav";
import { photo } from "../../lib/wireframe";
import { roleHero, leadFormBlock, faqBlock, COST_ANSWER, SUPERVISION_ANSWER } from "../../lib/role-blocks";
import { ROLE_FAMILIES, FAMILY_STATS, UNCOVERED_LIVE_ROLES, numWord } from "../../data/nav-options";
import type { Block as BlockType } from "../../lib/types";

const blocks: BlockType[] = [
  roleHero({
    h1: "Tell Us the Role You Need",
    sub: "The Six Crews in the Menu Are the Ones We Are Asked for Most",
    body: `AFIMAC staffs plenty of roles beyond those ${numWord(FAMILY_STATS.families)}. If what you are short of is not in the menu, tell us the role and when you need people on site, and we will tell you how long it would take to get them there.`,
    cta2: "How long it takes",
    cta2Href: "#timing",
    img: "Full-bleed hero · 2560×1440 JPG (min 2000px wide) · a supervisor on a plant floor mid-conversation, clipboard, crew working behind · muted industrial tone under the navy scrim · mobile crop 1080×1350",
    spec: `<b>Elementor:</b> the shared hero saved section. <b>This page is new</b> and has no approved copy deck behind it.`,
  }),

  leadFormBlock({
    n: "BLOCK 02 · THE FORM",
    h2: "What are you short of?",
    bullets: [
      "Whether it is a role we source",
      "How long it would take to get them there",
      "Crew size, and a ballpark cost",
    ],
    illo: "1200×1200 flat isometric vector beside the form · an open requisition motif — a seat outline on a floor plan · greys with safety-orange and blue",
    spec: `<b>Elementor:</b> Metform · EK Icon List · Button, Mobilization Sky band. <b>The form runs second rather than last</b> — it is the point of the page. <b>Add a free-text "What role are you short of?" field</b>; the shared form does not have one.`,
  }),

  {
    cls: "wash",
    id: "timing",
    n: "BLOCK 03 · SOURCING TIMELINES",
    h: `
  <h2>How long a role takes to source</h2>
  <p class="lead">AFIMAC recruits from a national network of more than 20,000 skilled and production workers. How fast a particular role reaches your site comes down to how many of those people hold it, what screening and credentials it needs, and how far they have to travel.</p>
  <div class="g3" style="margin-top:26px">
   <div class="card"><div class="blocknum">ROLES WE STAFF MOST OFTEN</div><h3>Days from a signed plan</h3><p style="margin:0">The ${numWord(FAMILY_STATS.families)} crews in the menu and the roles around them. We keep a deep bench in these trades, so most of the lead time goes on travel, housing and site onboarding.</p></div>
   <div class="card"><div class="blocknum">SPECIALIST AND UNCOMMON ROLES</div><h3>Longer to source</h3><p style="margin:0">There are fewer candidates to start from, so recruiting and screening take more time. You get a date before you commit to anything.</p></div>
   <div class="card"><div class="blocknum">LICENSES AND CLEARANCES</div><h3>Depends on the site</h3><p style="margin:0">Where a role needs a specific license, certification or site clearance, how long that takes to verify usually sets the schedule.</p></div>
  </div>
  <p style="margin-top:26px">We work out which of those applies on the first call and give you a timeline then. If it is longer than you can wait, we will say so.</p>
  <div class="note stop"><b>This block is the largest claim on the page and it is written for the prototype.</b> The three tiers, and the idea that sourcing time is the variable rather than availability, are inferred from the approved timing answer — <i>"within days of a signed plan; exact timing depends on role, headcount, location, and compliance requirements"</i> — and from the 20,000+ network figure. <b>Nothing here is client-supplied. Take the tiers to AFIMAC ops before build</b>, and get real ranges if they will give them.</div>`,
    spec: `<b>Elementor:</b> Container (3-col) · EK Icon Box ×3. <b>If ops supplies real ranges, put the numbers in.</b> Three qualitative tiers are weaker than three figures.`,
  },

  {
    n: "BLOCK 04 · EXAMPLES",
    h: `
  <h2>Roles we have staffed outside the ${numWord(FAMILY_STATS.families)}</h2>
  <p class="lead">A few examples, taken from the roles named across AFIMAC's industry pages. The list is not everything we fill.</p>
  <div class="g3" style="margin-top:26px">
   ${UNCOVERED_LIVE_ROLES.map(
     ([group, roles]) =>
       `<div class="card"><div class="blocknum">${group}</div><ul class="tick" style="margin-top:12px">${roles
         .map((r) => `<li>${r}</li>`)
         .join("")}</ul></div>`,
   ).join("")}
  </div>
  <p style="margin-top:24px">Not seeing your role? Ask anyway — this list only covers the roles AFIMAC&rsquo;s industry pages happen to name.</p>
  <div class="note"><b>Shown as examples on purpose.</b> The roles are read from AFIMAC's live industry pages with the ${numWord(FAMILY_STATS.families)} families' own job titles removed, so this page cannot name a role the site does not already name. <b>AFIMAC does not publish a closed list of roles, so neither does this block</b> — a page that prints one invites the reader to treat anything missing as a no.</div>`,
    spec: `<b>Elementor:</b> Container (3-col) · EK Icon List ×3. <b>Confirm the published list is still current</b> — it is transcribed from industry pages that predate this project. Shipping and Receiving Clerks is published under two groups and appears twice.`,
  },

  {
    cls: "blue",
    n: "BLOCK 05 · THE CREWS, FOR ANYONE IN THE WRONG PLACE",
    h: `
  <h2>Or start with a crew</h2>
  <p class="lead">If one of these is closer to what you are short of, its page has the job titles, the process and what is included.</p>
  <div class="g3" style="margin-top:24px">
   ${ROLE_FAMILIES.map(
     (f) => `<a class="card famcard" href="${u(f.pages[0].route)}"><h3>${f.label}</h3><p class="famroles">${f.roles.join(" · ")}</p><span class="readmore">See the crew &raquo;</span></a>`,
   ).join("")}
  </div>`,
    spec: `<b>Elementor:</b> Container (3-col) · EK Image Box ×6, Readiness Blue band. The same six cards as the section landing page — build once, place twice.`,
  },

  faqBlock({
    n: "BLOCK 06 · FAQ",
    cls: "wash",
    h2: "Before you ask",
    items: [
      ["Is there a list of roles you will not fill?", "No. Some roles take longer to source than others, and the first call is where we work out which yours is."],
      ["Can you staff a whole shift rather than a few seats?", "Yes. Published AFIMAC deployments run from a 12-person specialist team to a 99-person production deployment."],
      ["Who supervises the crew?", SUPERVISION_ANSWER],
      ["How fast can a crew be on site?", "Within days of a signed plan for the roles we staff most often. Less common roles take longer to recruit for, and you get that timeline before you commit to anything."],
      ["What does it cost?", COST_ANSWER],
    ],
    note: `<b>Two of these five are new.</b> “Is there a list of roles you will not fill” and the sourcing caveat in the timing answer are written for this page and have not been approved. The other three are the cluster's shared answers and match the <a href="${u("/faq")}">FAQ page</a> word for word. <b>Do not add the new two to the cluster FAQ schema until they are approved.</b>`,
    spec: `<b>Elementor:</b> EK Accordion (5 items) + FAQPage structured data.`,
  }),

  {
    n: "BLOCK 07 · WHAT HAPPENS NEXT",
    h: `
  <h2>After you send this</h2>
  <div class="g2" style="margin-top:24px">
   <div>
    <p>A specialist comes back to you within one business day. The first call covers what the role actually involves on your site, how many you need, and when you need them working.</p>
    <p>From there it runs like any other engagement — Assessment, Mobilization, Deployment, Demobilization. <a href="${u("/how-it-works")}">How It Works</a> has the detail.</p>
   </div>
   ${photo("1200×1500 JPG (4:5) beside the copy · two people at a plant-floor table with a site plan between them · muted tone · no staged handshake")}
  </div>
  <div class="note"><b>Confirm the routing before build.</b> This form is specified as going to the same destination as the rest of the cluster. <b>If AFIMAC wants enquiries for roles outside the six triaged differently, that decision has not been made.</b></div>`,
    spec: `<b>Elementor:</b> Heading · Text Editor · Image. "Within one business day" matches the form's own consent line — keep the two in step.`,
  },
];
---

<Prototype
  title="Other Roles We Deploy"
  crumb="Solutions › CSTL › Who We Deploy › Other Roles"
  url={`${B}who-we-deploy/other-roles/`}
  status="build"
  active="/who-we-deploy/other-roles"
  meta={{
    t: "Specialty Labor & Hard-to-Fill Role Staffing | AFIMAC Global",
    d: "Short of a role outside AFIMAC's six crews? Tell us what you need and when you need people on site, and we will tell you how long it takes to get them there.",
    k: "specialty labor staffing · hard-to-fill roles — secondary: instrumentation technicians · heavy equipment operators · inventory control staffing · logistics staffing",
  }}
>
  {blocks.map((b) => <Block {...b} />)}
</Prototype>
