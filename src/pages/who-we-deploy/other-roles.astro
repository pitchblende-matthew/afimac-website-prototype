---
/**
 * OTHER ROLES WE DEPLOY — the page behind the nav's "Looking for something
 * else?" entry.
 *
 * A form page. The families in the menu are the specialties AFIMAC is asked for
 * most; it staffs plenty of roles outside them. The page exists to say so and
 * take the enquiry.
 *
 * What it must NOT do is print a list of roles. AFIMAC recruits to the role
 * from a network of 20,000+, and any list a visitor reads as the catalogue
 * invites them to treat anything missing as a no. So the page answers with the
 * network and with sourcing time, and names no roles outside the menu.
 */
import Prototype from "../../layouts/Prototype.astro";
import Block from "../../components/Block.astro";
import { u } from "../../lib/base";
import { B } from "../../data/nav";
import { photo } from "../../lib/wireframe";
import { roleHero, leadFormBlock, faqBlock, COST_ANSWER, SUPERVISION_ANSWER } from "../../lib/role-blocks";
import { ROLE_FAMILIES, NETWORK_STATS } from "../../data/nav-options";
import type { Block as BlockType } from "../../lib/types";

const blocks: BlockType[] = [
  roleHero({
    h1: "Tell Us the Role You Need",
    sub: "The Specialties in the Menu Are the Ones We Are Asked for Most",
    body: `AFIMAC staffs plenty of roles beyond them. If what you are short of is not in the menu, tell us the role and when you need people on site, and we will tell you how long it would take to get them there.`,
    cta2: "How long it takes",
    cta2Href: "#timing",
    img: "Full-bleed hero · 2560×1440 JPG (min 2000px wide) · a supervisor on a plant floor mid-conversation, clipboard, crew working behind · muted industrial tone under the navy scrim · mobile crop 1080×1350",
    spec: `<b>Elementor:</b> the shared hero saved section. <b>This page is new</b> and has no approved copy deck behind it.`,
  }),

  leadFormBlock({
    n: "BLOCK 02 · THE FORM",
    h2: "What are you short of?",
    bullets: [
      "Whether it is a role we source",
      "How long it would take to get them there",
      "How many people, and a ballpark cost",
    ],
    illo: "1200×1200 flat isometric vector beside the form · an open requisition motif — a seat outline on a floor plan · greys with safety-orange and blue",
    spec: `<b>Elementor:</b> Metform · EK Icon List · Button, Mobilization Sky band. <b>The form runs second rather than last</b> — it is the point of the page. <b>Add a free-text "What role are you short of?" field</b>; the shared form does not have one.`,
  }),

  {
    n: "BLOCK 03 · THE NETWORK",
    h: `
  <h2>A network of 20,000+ to recruit from</h2>
  <p class="lead">AFIMAC draws from a network of 20,000+ skilled and unskilled workers who are vetted, mobile and ready to work. People are recruited for the role you are short of — one of them or over a hundred. The families in the menu are the trades AFIMAC is asked for most, and the network reaches well past them.</p>
  <div class="g4" style="margin-top:28px">
   ${NETWORK_STATS.map(([fig, label]) => `<div><div class="stat">${fig}</div><p>${label}</p></div>`).join("")}
  </div>
  <p style="margin-top:28px">Whether your role is one we place every week or one we have to go and find, we will tell you on the first call.</p>
  <div class="note"><b>The four figures are the June-05 approved set</b> — 40+ years, 20,000+ laborers, within 72 hours, 1&ndash;500+ crew size. The live site runs two other sets alongside it. <a href="${u("/brand-check")}">All conflicts &rarr;</a></div>`,
    spec: `<b>Elementor:</b> Heading · Text Editor · EK Funfact / Counter ×4. <b>The same four figures as the industry stat band</b>, so whichever set wins there wins here.`,
  },

  {
    cls: "wash",
    id: "timing",
    n: "BLOCK 04 · SOURCING TIMELINES",
    h: `
  <h2>How long a role takes to source</h2>
  <p class="lead">How fast a role reaches your site comes down to how many of those 20,000 hold it, what screening and credentials it needs, and how far they have to travel.</p>
  <div class="g3" style="margin-top:26px">
   <div class="card"><div class="blocknum">ROLES WE STAFF MOST OFTEN</div><h3>Days from a signed plan</h3><p style="margin:0">The specialties in the menu and the roles around them. We keep a deep bench in these trades, so most of the lead time goes on travel, housing and site onboarding.</p></div>
   <div class="card"><div class="blocknum">SPECIALIST AND UNCOMMON ROLES</div><h3>Longer to source</h3><p style="margin:0">There are fewer candidates to start from, so recruiting and screening take more time. You get a date before you commit to anything.</p></div>
   <div class="card"><div class="blocknum">LICENSES AND CLEARANCES</div><h3>Depends on the site</h3><p style="margin:0">Where a role needs a specific license, certification or site clearance, how long that takes to verify usually sets the schedule.</p></div>
  </div>
  <p style="margin-top:26px">We work out which of those applies on the first call and give you a timeline then. If it is longer than you can wait, we will say so.</p>
  <div class="note stop"><b>This block is the largest claim on the page and it is written for the prototype.</b> The three tiers, and the idea that sourcing time is the variable rather than availability, are inferred from the approved timing answer — <i>"within days of a signed plan; exact timing depends on role, headcount, location, and compliance requirements"</i> — and from the 20,000+ network figure. <b>Nothing here is client-supplied. Take the tiers to AFIMAC ops before build</b>, and get real ranges if they will give them.</div>`,
    spec: `<b>Elementor:</b> Container (3-col) · EK Icon Box ×3. <b>If ops supplies real ranges, put the numbers in.</b> Three qualitative tiers are weaker than three figures.`,
  },

  {
    cls: "blue",
    n: "BLOCK 05 · THE SPECIALTIES, FOR ANYONE IN THE WRONG PLACE",
    h: `
  <h2>Some of what AFIMAC specializes in</h2>
  <p class="lead">These are the specialties AFIMAC is asked for most often. If one of them is closer to what you are short of, its page has the job titles, the process and what is included.</p>
  <div class="g3" style="margin-top:24px">
   ${ROLE_FAMILIES.map(
     (f) => `<a class="card famcard" href="${u(f.pages[0].route)}"><h3>${f.label}</h3><p class="famroles">${f.roles.join(" · ")}</p><span class="readmore">What it covers &raquo;</span></a>`,
   ).join("")}
  </div>`,
    spec: `<b>Elementor:</b> Container (3-col) · EK Image Box ×6, Readiness Blue band. The same cards as the section landing page — build once, place twice. <b>The wording differs on purpose:</b> this page calls them specialties rather than crews, because a visitor who has landed here has already not found their role among them.`,
  },

  faqBlock({
    n: "BLOCK 06 · FAQ",
    cls: "wash",
    h2: "Before you ask",
    items: [
      ["Is there a list of roles you will not fill?", "No. AFIMAC recruits to the role from a network of 20,000+ workers. Some roles take longer to source than others, and the first call is where we work out which yours is."],
      ["How many people can you send?", "Anywhere from one to over a hundred. Published AFIMAC deployments run from a 12-person specialist team to a 99-person production deployment, and the headcount can move up or down while the engagement runs."],
      ["Who supervises them?", SUPERVISION_ANSWER],
      ["How fast can people be on site?", "Within days of a signed plan for the roles we staff most often. Less common roles take longer to recruit for, and you get that timeline before you commit to anything."],
      ["What does it cost?", COST_ANSWER],
    ],
    note: `<b>Three of these five are new or changed.</b> “Is there a list of roles you will not fill” and the sourcing caveat in the timing answer are written for this page. <b>“How many people can you send?” replaces “Can you staff a whole shift rather than a few seats?”</b> and leads with the range rather than the shift, because the scale argument is one person to over a hundred; both figures in the answer are published AFIMAC deployments. The remaining two are the cluster's shared answers and match the <a href="${u("/faq")}">FAQ page</a> word for word. <b>Do not add the new three to the cluster FAQ schema until they are approved.</b>`,
    spec: `<b>Elementor:</b> EK Accordion (5 items) + FAQPage structured data.`,
  }),

  {
    n: "BLOCK 07 · WHAT HAPPENS NEXT",
    h: `
  <h2>After you send this</h2>
  <div class="g2" style="margin-top:24px">
   <div>
    <p>A specialist comes back to you within one business day. The first call covers what the role actually involves on your site, how many you need, and when you need them working.</p>
    <p>From there it runs like any other engagement — Assessment, Mobilization, Deployment, Demobilization. <a href="${u("/how-it-works")}">How It Works</a> has the detail.</p>
   </div>
   ${photo("1200×1500 JPG (4:5) beside the copy · two people at a plant-floor table with a site plan between them · muted tone · no staged handshake")}
  </div>
  <div class="note"><b>Confirm the routing before build.</b> This form is specified as going to the same destination as the rest of the cluster. <b>If AFIMAC wants enquiries for roles outside the listed specialties triaged differently, that decision has not been made.</b></div>`,
    spec: `<b>Elementor:</b> Heading · Text Editor · Image. "Within one business day" matches the form's own consent line — keep the two in step.`,
  },
];
---

<Prototype
  title="Other Roles We Deploy"
  crumb="Solutions › CSTL › Who We Deploy › Other Roles"
  url={`${B}who-we-deploy/other-roles/`}
  status="build"
  active="/who-we-deploy/other-roles"
  meta={{
    t: "Specialty Labor & Hard-to-Fill Role Staffing | AFIMAC Global",
    d: "Short of a role that is not in the menu? AFIMAC recruits to the role from a network of 20,000+ vetted, mobile workers. Tell us what you need and when.",
    k: "specialty labor staffing · hard-to-fill roles — secondary: skilled labor network · contract labor recruiting · travel labor staffing · workforce gap staffing",
  }}
>
  {blocks.map((b) => <Block {...b} />)}
</Prototype>
